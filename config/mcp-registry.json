{
  "version": "2.0.0",
  "description": "MCP Native registry — managed by mcp-manager.ps1",
  "servers": [
    {
      "name": "skill-server",
      "type": "builtin",
      "transport": "stdio",
      "command": "node",
      "args": ["dist/scripts/mcp/skill-server.js"],
      "enabled": true,
      "autoStart": true,
      "description": "143+ internal skills via MCP: list_skills, get_skill, search_skills"
    },
    {
      "name": "engram-mcp",
      "type": "builtin",
      "transport": "stdio",
      "command": "npx",
      "args": ["engram", "mcp"],
      "enabled": true,
      "autoStart": true,
      "description": "Persistent memory via Engram MCP"
    }
  ]
}
