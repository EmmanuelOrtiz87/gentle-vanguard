{
  "version": "1.0.0",
  "description": "Backup rotation and retention policy for Gentle-Vanguard state persistence",
  "lastUpdated": "2026-06-19",

  "checkpoints": {
    "maxCount": 10,
    "maxAgeHours": 72,
    "autoCreateOnSessionStart": true,
    "autoCreateOnCorrection": true,
    "autoCreateBeforeRollback": true,
    "compressionEnabled": false,
    "integrityCheckOnCreate": true
  },

  "snapshots": {
    "enabled": true,
    "intervalSeconds": 300,
    "retentionDays": 7,
    "criticalFiles": [
      "session-state.json",
      "token-usage.json",
      "cloud-metrics.json",
      "hybrid-metrics.json",
      "metrics-report.json",
      "health.json"
    ],
    "autoCleanup": true
  },

  "rollback": {
    "requireHealthCheck": true,
    "requireIntegrityCheck": true,
    "autoBackupBeforeRollback": true,
    "allowedStaleHours": 24,
    "maxRollbacksPerSession": 3
  },

  "storage": {
    "baseDir": ".session",
    "checkpointDir": ".session/checkpoints",
    "manifestDir": ".session/manifests",
    "snapshotDir": ".session/snapshots",
    "logFile": ".session/checkpoint.log",
    "rollbackLogFile": ".session/rollback.log"
  },

  "alerts": {
    "checkpointFailureThreshold": 3,
    "staleCheckpointThresholdHours": 24,
    "rollbackFailureAlert": true,
    "diskUsageWarningPercent": 80
  }
}
