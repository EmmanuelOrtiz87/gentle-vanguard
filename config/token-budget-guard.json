{
  "$schema": "./token-budget-guard-schema.json",
  "version": "2.0.0",
  "description": "Token budget configuration — SINGLE SOURCE OF TRUTH. This file is the authoritative config for all token budgeting across the stack.",
  "last_updated": "2026-07-24",

  "tokenBudget": {
    "version": "2.0.0",
    "limits": {
      "daily": 120000,
      "perSession": 15000,
      "perAgent": 3000,
      "softThreshold": 70,
      "hardThreshold": 90
    },
    "tracking": {
      "enabled": true,
      "actualTokens": true,
      "estimatedTokens": true,
      "costTracking": true,
      "metricsPath": "docs/sessions/metrics/token-guard-usage.csv"
    },
    "enforcement": {
      "mode": "soft",
      "requireEngram": false,
      "nonBlocking": true
    },
    "notifications": {
      "enabled": true,
      "softAlert": true,
      "hardAlert": true
    },
    "agentLimits": {
      "orchestrator": { "minTokens": 2000, "maxTokens": 4500, "steps": 12 },
      "sdd-explore": { "minTokens": 2000, "maxTokens": 5000, "steps": 6 },
      "sdd-design": { "minTokens": 2000, "maxTokens": 5000, "steps": 6 },
      "sdd-apply": { "minTokens": 2000, "maxTokens": 6000, "steps": 6 },
      "sdd-verify": { "minTokens": 2000, "maxTokens": 5000, "steps": 6 },
      "doc-agent": { "minTokens": 2000, "maxTokens": 5000, "steps": 6 },
      "ops-agent": { "minTokens": 2000, "maxTokens": 5000, "steps": 6 },
      "gov-agent": { "minTokens": 2000, "maxTokens": 5000, "steps": 6 },
      "session-agent": { "minTokens": 1000, "maxTokens": 2000, "steps": 6 },
      "premortem-agent": { "minTokens": 2000, "maxTokens": 6000, "steps": 6 }
    },
    "modelPricing": {
      "openrouter/z-ai/glm-5": { "input": 0.15, "output": 0.6 },
      "openrouter/moonshot/kimi-k2.6": { "input": 0.25, "output": 1.25 },
      "openrouter/qwen/qwen-3.6-plus": { "input": 0.1, "output": 0.4 }
    },
    "alerting": {
      "dailyCostExceeded": { "severity": "WARNING", "action": "log_and_notify" },
      "dailyTokensExceeded": { "severity": "WARNING", "action": "log_and_notify" },
      "agentLimitExceeded": { "severity": "WARNING", "action": "log_and_notify" },
      "taskLimitExceeded": { "severity": "WARNING", "action": "log_and_notify" },
      "costSpike2x": { "severity": "WARNING", "action": "investigate" },
      "runawayUsage": { "severity": "CRITICAL", "action": "kill_task" }
    },
    "references": {
      "opencodeAgentConfig": "opencode.json#agent",
      "orchestratorBudget": "config/orchestrator.json#subagent_orchestration.token_budget_guard",
      "timeoutConfig": "config/timeout-config.json#token_budget_daily"
    }
  }
}
