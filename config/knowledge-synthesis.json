{
  "version": "1.0.0",
  "description": "Knowledge Synthesizer configuration — cross-session knowledge distillation and mapping",
  "minSessionsForTrend": 2,
  "maxKnowledgeMaps": 5,
  "maxTrends": 10,
  "maxGaps": 8,
  "outputDir": ".session/knowledge",
  "synthesis": {
    "enabled": true,
    "runAfterReflection": true,
    "maxSourcesPerRun": 50
  },
  "sources": {
    "engramContext": true,
    "sessionDigests": true,
    "reflectionOutputs": true,
    "auditLogs": true,
    "metrics": true,
    "knowledgeBase": true,
    "fineTuningData": true,
    "contextLogs": true
  },
  "knowledgeMap": {
    "maxConcepts": 50,
    "maxRelationships": 100,
    "minConfidence": 0.3
  },
  "trendAnalysis": {
    "windowDays": 14,
    "minDataPoints": 3,
    "detectAccelerations": true
  },
  "gapAnalysis": {
    "enabled": true,
    "minEvidenceCount": 2,
    "suggestSources": true
  }
}
