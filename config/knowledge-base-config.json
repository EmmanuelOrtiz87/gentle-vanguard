{
  "version": "1.0.0",
  "vault_path": "knowledge-base",
  "folders": {
    "inbox": "00-inbox",
    "projects": "01-projects",
    "architecture": "02-architecture",
    "skills": "03-skills",
    "sessions": "04-sessions",
    "research": "05-research",
    "templates": "06-templates",
    "archive": "07-archive"
  },
  "sync": {
    "enabled": true,
    "engram_sync": true,
    "auto_archive_days": 30,
    "session_sync": true
  },
  "templates": {
    "project": "06-templates/project.md",
    "session": "06-templates/session.md",
    "skill": "06-templates/skill.md",
    "decision": "06-templates/decision.md"
  },
  "naming": {
    "date_format": "yyyy-MM-dd",
    "separator": "-"
  },
  "validation": {
    "require_frontmatter": true,
    "require_tags": true,
    "allowed_tags": [
      "project",
      "session",
      "skill",
      "decision",
      "research",
      "architecture",
      "inbox",
      "archive"
    ]
  },
  "backup": {
    "enabled": true,
    "path": ".session/snapshots/knowledge-base"
  }
}
