{
  "version": "1.0.0",
  "name": "prompt-compression-config",
  "description": "Skill-aware prompt compression configuration — each skill defines how aggressively prompts are compressed before submission",
  "defaultCompressionRatio": 0.4,
  "preserveCodeBlocks": true,
  "minPreservedLines": 10,
  "maxPreservedLines": 1000,
  "tokenBudgetAware": true,
  "deduplicateLines": true,
  "removeBoilerplate": true,
  "boilerplatePatterns": [
    "por favor",
    "please",
    "thank you",
    "gracias",
    "thanks",
    "let me know",
    "avísame",
    "saludos",
    "regards",
    "atte.",
    "atentamente",
    "cordially"
  ],
  "lowInfoPatterns": ["^[-=_*]{3,}$", "^\\s*$", "^\\s*#+\\s*$", "^\\s*$"],
  "skills": {
    "security-skill": {
      "compressionRatio": 0.1,
      "preserveCodeBlocks": true,
      "notes": "Security: minimal compression — preserve policy details, exact commands"
    },
    "governance": {
      "compressionRatio": 0.15,
      "preserveCodeBlocks": true,
      "notes": "Governance: low compression — compliance details must be complete"
    },
    "testing-skill": {
      "compressionRatio": 0.5,
      "preserveCodeBlocks": true,
      "notes": "Testing: moderate compression — test cases have high repetition"
    },
    "testing-strategy": {
      "compressionRatio": 0.5,
      "preserveCodeBlocks": true
    },
    "react-19": {
      "compressionRatio": 0.35,
      "preserveCodeBlocks": true,
      "notes": "React: preserve code blocks (JSX patterns), compress explanatory text"
    },
    "react-19-skill": {
      "compressionRatio": 0.35,
      "preserveCodeBlocks": true
    },
    "golang-api": {
      "compressionRatio": 0.3,
      "preserveCodeBlocks": true
    },
    "docker-devops": {
      "compressionRatio": 0.4,
      "preserveCodeBlocks": true
    },
    "documentation": {
      "compressionRatio": 0.5,
      "preserveCodeBlocks": false,
      "notes": "Docs: higher compression — prose is verbose, code examples less critical"
    },
    "nexus-database": {
      "compressionRatio": 0.3,
      "preserveCodeBlocks": true
    },
    "mcp-skill": {
      "compressionRatio": 0.25,
      "preserveCodeBlocks": true
    },
    "api-design": {
      "compressionRatio": 0.3,
      "preserveCodeBlocks": true
    },
    "bugfix": {
      "compressionRatio": 0.2,
      "preserveCodeBlocks": true,
      "notes": "Bugfix: low compression — error messages and stack traces must be exact"
    },
    "debugging-skill": {
      "compressionRatio": 0.2,
      "preserveCodeBlocks": true
    },
    "ci-cd": {
      "compressionRatio": 0.4,
      "preserveCodeBlocks": true
    },
    "planning": {
      "compressionRatio": 0.5,
      "preserveCodeBlocks": false,
      "notes": "Planning: higher compression — lists and outlines are repetitive"
    }
  }
}
