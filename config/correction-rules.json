{
  "version": "1.0.0",
  "description": "Auto-Correction Rules Engine Configuration — Judgment Day Rules",
  "lastUpdated": "2026-06-19T00:00:00Z",
  "rules": [
    {
      "id": "TokenBudgetExceeded",
      "trigger": {
        "condition": "score < 50",
        "description": "Session score indicates token budget exceeded"
      },
      "action": {
        "type": "reduce_complexity",
        "target": "skillComplexityTier",
        "value": "BASIC",
        "description": "Reduce skill complexity to BASIC tier"
      },
      "metadata": {
        "pattern": "token_overrun",
        "confidence": 0.92,
        "successRate": 0.88,
        "impactLevel": "high",
        "estimatedRecoveryTime": "10s"
      },
      "rollback": {
        "enabled": true,
        "strategy": "restore_complexity_tier"
      }
    },
    {
      "id": "HighErrorRate",
      "trigger": {
        "condition": "score < 40",
        "description": "Error rate exceeds 15% of operations"
      },
      "action": {
        "type": "enable_safety_mode",
        "target": "orchestrator",
        "actions": ["enable_premortem", "require_manual_review", "enable_detailed_logging"],
        "description": "Activate premortem mode + manual review requirement"
      },
      "metadata": {
        "pattern": "error_spike",
        "confidence": 0.85,
        "successRate": 0.82,
        "impactLevel": "critical",
        "estimatedRecoveryTime": "30s"
      },
      "rollback": {
        "enabled": true,
        "strategy": "disable_safety_mode"
      }
    },
    {
      "id": "LowQualityScore",
      "trigger": {
        "condition": "score < 60",
        "description": "Overall quality metrics below threshold"
      },
      "action": {
        "type": "enforce_process",
        "target": "sdd_lifecycle",
        "mode": "strict",
        "description": "Enforce full BA → SAD → DEV → QA cycle"
      },
      "metadata": {
        "pattern": "quality_degradation",
        "confidence": 0.88,
        "successRate": 0.85,
        "impactLevel": "high",
        "estimatedRecoveryTime": "45s"
      },
      "rollback": {
        "enabled": true,
        "strategy": "disable_sdd_enforcement"
      }
    },
    {
      "id": "AgentMisalignment",
      "trigger": {
        "condition": "score < 45",
        "description": "Agent delegation confidence below acceptable threshold"
      },
      "action": {
        "type": "increase_confidence_requirement",
        "target": "auto_delegation",
        "minimumConfidenceThreshold": 0.85,
        "description": "Increase confidence threshold to 85% for agent selection"
      },
      "metadata": {
        "pattern": "agent_misroute",
        "confidence": 0.8,
        "successRate": 0.78,
        "impactLevel": "medium",
        "estimatedRecoveryTime": "20s"
      },
      "rollback": {
        "enabled": true,
        "strategy": "restore_default_confidence"
      }
    },
    {
      "id": "CacheMiss",
      "trigger": {
        "condition": "score < 70",
        "description": "Cache hit ratio below 60%"
      },
      "action": {
        "type": "warm_cache",
        "target": "embeddings_cache",
        "strategy": "aggressive_preload",
        "description": "Pre-warm embedding cache with common queries"
      },
      "metadata": {
        "pattern": "cache_inefficiency",
        "confidence": 0.75,
        "successRate": 0.7,
        "impactLevel": "medium",
        "estimatedRecoveryTime": "60s"
      },
      "rollback": {
        "enabled": false,
        "strategy": "no_rollback_needed"
      }
    },
    {
      "id": "SkillVersionMismatch",
      "trigger": {
        "condition": "score < 55",
        "description": "Skill version incompatibility detected"
      },
      "action": {
        "type": "rollback_version",
        "target": "skills_lock",
        "strategy": "use_previous_version",
        "description": "Rollback skills to previous known-good version"
      },
      "metadata": {
        "pattern": "version_incompatibility",
        "confidence": 0.9,
        "successRate": 0.87,
        "impactLevel": "high",
        "estimatedRecoveryTime": "15s"
      },
      "rollback": {
        "enabled": true,
        "strategy": "restore_latest_version"
      }
    },
    {
      "id": "EngineOverload",
      "trigger": {
        "condition": "score < 50",
        "description": "Concurrent operations exceed capacity"
      },
      "action": {
        "type": "apply_throttling",
        "target": "circuit_breaker",
        "rateLimitReduction": 0.5,
        "description": "Reduce rate limit by 50% to prevent overload"
      },
      "metadata": {
        "pattern": "resource_exhaustion",
        "confidence": 0.83,
        "successRate": 0.81,
        "impactLevel": "critical",
        "estimatedRecoveryTime": "25s"
      },
      "rollback": {
        "enabled": true,
        "strategy": "restore_rate_limit"
      }
    },
    {
      "id": "MemoryFragmentation",
      "trigger": {
        "condition": "score < 65",
        "description": "Engram memory fragmentation exceeds 30%"
      },
      "action": {
        "type": "defragment_memory",
        "target": "engram",
        "operation": "regenerate_checksums",
        "description": "Regenerate Engram checksums to fix fragmentation"
      },
      "metadata": {
        "pattern": "memory_corruption",
        "confidence": 0.78,
        "successRate": 0.95,
        "impactLevel": "medium",
        "estimatedRecoveryTime": "30s"
      },
      "rollback": {
        "enabled": true,
        "strategy": "restore_from_backup"
      }
    },
    {
      "id": "MCP_BridgeFailure",
      "trigger": {
        "condition": "score < 40",
        "description": "MCP bridge connectivity < 90%"
      },
      "action": {
        "type": "restart_service",
        "target": "mcp_server",
        "retries": 3,
        "description": "Restart MCP server with gradual retry backoff"
      },
      "metadata": {
        "pattern": "service_degradation",
        "confidence": 0.87,
        "successRate": 0.89,
        "impactLevel": "high",
        "estimatedRecoveryTime": "20s"
      },
      "rollback": {
        "enabled": false,
        "strategy": "manual_intervention"
      }
    },
    {
      "id": "DashboardLatency",
      "trigger": {
        "condition": "score < 60",
        "description": "Dashboard websocket latency > 500ms"
      },
      "action": {
        "type": "optimize_metrics",
        "target": "dashboard_pipeline",
        "reduce_granularity": true,
        "description": "Reduce metrics granularity to lower payload size"
      },
      "metadata": {
        "pattern": "network_latency",
        "confidence": 0.72,
        "successRate": 0.75,
        "impactLevel": "low",
        "estimatedRecoveryTime": "10s"
      },
      "rollback": {
        "enabled": true,
        "strategy": "restore_granularity"
      }
    },
    {
      "id": "SecurityPolicyViolation",
      "trigger": {
        "condition": "score < 30",
        "description": "Security violations detected in audit log"
      },
      "action": {
        "type": "enforce_lockdown",
        "target": "security_policy",
        "mode": "strict_isolation",
        "description": "Enable strict isolation mode + require approval for all operations"
      },
      "metadata": {
        "pattern": "security_breach",
        "confidence": 0.99,
        "successRate": 0.98,
        "impactLevel": "critical",
        "estimatedRecoveryTime": "60s"
      },
      "rollback": {
        "enabled": true,
        "strategy": "manual_unlock_required"
      }
    },
    {
      "id": "ModelProviderUnsupported",
      "trigger": {
        "condition": "provider_error_signature",
        "description": "Provider LLM error signature detected in opencode logs (e.g. UnsupportedParamsError / Bedrock tool calling / Model not found)"
      },
      "action": {
        "type": "switch_to_fallback_model",
        "target": "model-provider-healer",
        "fallbackModel": "kimi-2-5",
        "description": "Run model-provider-healer to mark the failing model unhealthy and auto-switch the active model to the native fallback"
      },
      "metadata": {
        "pattern": "provider_error",
        "confidence": 0.9,
        "successRate": 0.95,
        "impactLevel": "critical",
        "estimatedRecoveryTime": "10s"
      },
      "rollback": {
        "enabled": true,
        "strategy": "switch_back_to_requested_model"
      }
    },
    {
      "id": "ReasoningEffortIncompatible",
      "trigger": {
        "condition": "provider_error_signature",
        "description": "Bedrock provider reported incompatibility with reasoning_effort parameter"
      },
      "action": {
        "type": "apply_provider_specific_fix",
        "target": "litellm_config",
        "fixType": "drop_reasoning_effort",
        "description": "Apply provider-specific configuration to drop reasoning_effort parameter for Bedrock-compatible providers"
      },
      "metadata": {
        "pattern": "reasoning_effort.*not supported|UnsupportedParamsError.*reasoning_effort",
        "confidence": 0.95,
        "successRate": 0.98,
        "impactLevel": "high",
        "estimatedRecoveryTime": "5s"
      },
      "rollback": {
        "enabled": true,
        "strategy": "restore_normal_config"
      }
    },
    {
      "id": "SkillDependencyConflict",
      "trigger": {
        "condition": "score < 52",
        "description": "Skill dependency resolution failures > 10%"
      },
      "action": {
        "type": "resolve_dependencies",
        "target": "skill_dependencies",
        "strategy": "conservative_resolution",
        "description": "Resolve conflicts using conservative dependency strategy"
      },
      "metadata": {
        "pattern": "dependency_mismatch",
        "confidence": 0.81,
        "successRate": 0.79,
        "impactLevel": "medium",
        "estimatedRecoveryTime": "40s"
      },
      "rollback": {
        "enabled": true,
        "strategy": "restore_dependency_dag"
      }
    }
  ],
  "globalSettings": {
    "maxConcurrentCorrections": 3,
    "correctionTimeout": 30000,
    "rollbackEnabled": true,
    "autoMetricsRecording": true,
    "minConfidenceToExecute": 0.7,
    "maxRollbackAttempts": 2
  },
  "learningMode": {
    "enabled": true,
    "updateInterval": 86400,
    "successRateThreshold": 0.8,
    "confidenceAdjustment": 0.02
  }
}
