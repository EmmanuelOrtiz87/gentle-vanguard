{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "config/timeout-config.schema.json",
  "title": "Timeout Configuration Schema",
  "description": "Schema de validación para la configuración centralizada de timeouts del stack Gentle-Vanguard",
  "type": "object",
  "required": ["version", "description", "global"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Reference to this schema file"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Schema version in semver format"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of this configuration"
    },
    "global": {
      "type": "object",
      "required": [
        "default_timeout_ms",
        "default_retry_attempts",
        "default_retry_delay_ms",
        "default_retry_backoff_factor"
      ],
      "additionalProperties": false,
      "properties": {
        "default_timeout_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Default timeout in milliseconds for all operations"
        },
        "default_retry_attempts": {
          "type": "integer",
          "minimum": 0,
          "description": "Default number of retry attempts"
        },
        "default_retry_delay_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Default delay between retries in milliseconds"
        },
        "default_retry_backoff_factor": {
          "type": "number",
          "minimum": 1.0,
          "description": "Exponential backoff multiplier"
        },
        "description": { "type": "string", "description": "Human-readable description" }
      }
    },
    "http_server": {
      "type": "object",
      "required": [
        "socket_timeout_ms",
        "headers_timeout_ms",
        "keep_alive_timeout_ms",
        "request_timeout_ms",
        "response_timeout_ms",
        "shutdown_graceful_ms",
        "shutdown_force_ms"
      ],
      "additionalProperties": false,
      "properties": {
        "socket_timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000,
          "description": "TCP socket timeout in milliseconds"
        },
        "headers_timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 300000,
          "description": "Maximum time to wait for headers in milliseconds"
        },
        "keep_alive_timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000,
          "description": "Keep-alive socket idle timeout in milliseconds"
        },
        "request_timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000,
          "description": "Max time for entire HTTP request in milliseconds"
        },
        "response_timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000,
          "description": "Max time to wait for response body in milliseconds"
        },
        "shutdown_graceful_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000,
          "description": "Graceful shutdown wait time in milliseconds"
        },
        "shutdown_force_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 30000,
          "description": "Force kill after graceful timeout in milliseconds"
        },
        "description": { "type": "string" }
      }
    },
    "websocket": {
      "type": "object",
      "required": [
        "ping_interval_ms",
        "pong_timeout_ms",
        "handshake_timeout_ms",
        "reconnect_delay_base_ms",
        "reconnect_delay_max_ms",
        "reconnect_max_attempts",
        "heartbeat_interval_ms"
      ],
      "additionalProperties": false,
      "properties": {
        "ping_interval_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000,
          "description": "Interval between WebSocket ping frames in milliseconds"
        },
        "pong_timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000,
          "description": "Max time to wait for pong response in milliseconds"
        },
        "handshake_timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 30000,
          "description": "WebSocket connection handshake timeout in milliseconds"
        },
        "reconnect_delay_base_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10000,
          "description": "Base delay before reconnect attempt in milliseconds"
        },
        "reconnect_delay_max_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 300000,
          "description": "Maximum reconnect delay with backoff in milliseconds"
        },
        "reconnect_max_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Maximum number of reconnection attempts"
        },
        "heartbeat_interval_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000,
          "description": "Heartbeat check interval in milliseconds"
        },
        "description": { "type": "string" }
      }
    },
    "external_api": {
      "type": "object",
      "required": ["http_client_default_ms", "http_client_max_ms"],
      "additionalProperties": false,
      "properties": {
        "http_client_default_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 300000,
          "description": "Default HTTP client timeout in milliseconds"
        },
        "http_client_max_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000,
          "description": "Maximum HTTP client timeout in milliseconds"
        },
        "openai_request_ms": { "type": "integer", "minimum": 1000, "maximum": 600000 },
        "anthropic_request_ms": { "type": "integer", "minimum": 1000, "maximum": 600000 },
        "openrouter_request_ms": { "type": "integer", "minimum": 1000, "maximum": 600000 },
        "ollama_request_ms": { "type": "integer", "minimum": 1000, "maximum": 600000 },
        "github_api_ms": { "type": "integer", "minimum": 1000, "maximum": 300000 },
        "jira_api_ms": { "type": "integer", "minimum": 1000, "maximum": 300000 },
        "confluence_api_ms": { "type": "integer", "minimum": 1000, "maximum": 300000 },
        "engram_operation_ms": { "type": "integer", "minimum": 1000, "maximum": 120000 },
        "mcp_bridge_start_ms": { "type": "integer", "minimum": 1000, "maximum": 120000 },
        "mcp_request_ms": { "type": "integer", "minimum": 1000, "maximum": 120000 },
        "description": { "type": "string" }
      }
    },
    "process_execution": {
      "type": "object",
      "required": ["script_default_ms", "script_long_running_ms"],
      "additionalProperties": false,
      "properties": {
        "script_default_ms": { "type": "integer", "minimum": 1000, "maximum": 600000 },
        "script_long_running_ms": { "type": "integer", "minimum": 1000, "maximum": 600000 },
        "git_operation_ms": { "type": "integer", "minimum": 1000, "maximum": 120000 },
        "npm_command_ms": { "type": "integer", "minimum": 1000, "maximum": 600000 },
        "pnpm_command_ms": { "type": "integer", "minimum": 1000, "maximum": 600000 },
        "tsc_typecheck_ms": { "type": "integer", "minimum": 1000, "maximum": 600000 },
        "pipeline_step_ms": { "type": "integer", "minimum": 1000, "maximum": 600000 },
        "health_check_ms": { "type": "integer", "minimum": 1000, "maximum": 120000 },
        "watchdog_restart_delay_ms": { "type": "integer", "minimum": 100, "maximum": 60000 },
        "spawn_max_buffer_bytes": { "type": "integer", "minimum": 1024, "maximum": 1073741824 },
        "description": { "type": "string" }
      }
    },
    "pipeline": {
      "type": "object",
      "required": ["session_autostart_step_ms"],
      "additionalProperties": false,
      "properties": {
        "session_autostart_step_ms": { "type": "integer", "minimum": 1000, "maximum": 600000 },
        "lazy_step_ms": { "type": "integer", "minimum": 1000, "maximum": 600000 },
        "phase_timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
        "required_step_ms": { "type": "integer", "minimum": 1000, "maximum": 600000 },
        "orphan_cleanup_max_age_hours": { "type": "integer", "minimum": 1, "maximum": 168 },
        "session_expiry_hours": { "type": "integer", "minimum": 1, "maximum": 72 },
        "description": { "type": "string" }
      }
    },
    "dashboard": {
      "type": "object",
      "required": ["ws_reconnect_interval_ms", "http_polling_interval_ms", "watchdog_max_restarts"],
      "additionalProperties": false,
      "properties": {
        "ws_reconnect_interval_ms": { "type": "integer", "minimum": 100, "maximum": 60000 },
        "http_polling_interval_ms": { "type": "integer", "minimum": 100, "maximum": 60000 },
        "metrics_refresh_ms": { "type": "integer", "minimum": 100, "maximum": 60000 },
        "port_scan_timeout_ms": { "type": "integer", "minimum": 100, "maximum": 30000 },
        "watchdog_check_interval_ms": { "type": "integer", "minimum": 100, "maximum": 60000 },
        "watchdog_max_restarts": { "type": "integer", "minimum": 0, "maximum": 100 },
        "vite_dev_timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 300000 },
        "description": { "type": "string" }
      }
    },
    "database": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "engram_db_query_ms": { "type": "integer", "minimum": 100, "maximum": 120000 },
        "engram_db_backup_ms": { "type": "integer", "minimum": 1000, "maximum": 600000 },
        "engram_db_compact_ms": { "type": "integer", "minimum": 1000, "maximum": 600000 },
        "sqlite_busy_timeout_ms": { "type": "integer", "minimum": 100, "maximum": 60000 },
        "sqlite_wal_checkpoint_ms": { "type": "integer", "minimum": 100, "maximum": 60000 },
        "codegraph_sync_ms": { "type": "integer", "minimum": 1000, "maximum": 600000 },
        "description": { "type": "string" }
      }
    },
    "cache": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "response_cache_ttl_ms": { "type": "integer", "minimum": 1000, "maximum": 86400000 },
        "session_cache_ttl_ms": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
        "metrics_cache_ttl_ms": { "type": "integer", "minimum": 100, "maximum": 3600000 },
        "dns_cache_ttl_ms": { "type": "integer", "minimum": 0, "maximum": 86400000 },
        "description": { "type": "string" }
      }
    },
    "session": {
      "type": "object",
      "required": ["idle_timeout_minutes", "max_duration_minutes"],
      "additionalProperties": false,
      "properties": {
        "idle_timeout_minutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
        "max_duration_minutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
        "auth_timeout_minutes": { "type": "integer", "minimum": 1, "maximum": 120 },
        "token_budget_daily": { "type": "integer", "minimum": 100, "maximum": 10000000 },
        "token_soft_limit_pct": { "type": "integer", "minimum": 1, "maximum": 100 },
        "token_hard_limit_pct": { "type": "integer", "minimum": 1, "maximum": 100 },
        "description": { "type": "string" }
      }
    },
    "hooks": {
      "type": "object",
      "required": ["pre_process_ms", "pre_commit_ms", "execution_global_ms"],
      "additionalProperties": false,
      "properties": {
        "pre_process_ms": { "type": "integer", "minimum": 1000, "maximum": 300000 },
        "post_session_ms": { "type": "integer", "minimum": 1000, "maximum": 300000 },
        "pre_commit_ms": { "type": "integer", "minimum": 1000, "maximum": 300000 },
        "post_merge_ms": { "type": "integer", "minimum": 1000, "maximum": 300000 },
        "execution_global_ms": { "type": "integer", "minimum": 1000, "maximum": 600000 },
        "description": { "type": "string" }
      }
    },
    "monitoring": {
      "type": "object",
      "required": [
        "health_check_interval_ms",
        "metrics_collection_interval_ms",
        "alert_cooldown_ms"
      ],
      "additionalProperties": false,
      "properties": {
        "health_check_interval_ms": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
        "metrics_collection_interval_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 3600000
        },
        "alert_cooldown_ms": { "type": "integer", "minimum": 1000, "maximum": 86400000 },
        "log_rotation_interval_ms": { "type": "integer", "minimum": 3600000, "maximum": 604800000 },
        "cleanup_interval_ms": { "type": "integer", "minimum": 60000, "maximum": 86400000 },
        "description": { "type": "string" }
      }
    },
    "circuit_breaker": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "engram": { "$ref": "#/definitions/circuitBreakerEntry" },
        "git_remote": { "$ref": "#/definitions/circuitBreakerEntry" },
        "external_api": { "$ref": "#/definitions/circuitBreakerEntry" },
        "description": { "type": "string" }
      }
    },
    "environments": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "development": { "$ref": "#/definitions/environmentEntry" },
        "production": { "$ref": "#/definitions/environmentEntry" },
        "ci": { "$ref": "#/definitions/environmentEntry" }
      }
    }
  },
  "definitions": {
    "circuitBreakerEntry": {
      "type": "object",
      "required": ["failure_threshold", "reset_seconds", "half_open_max_requests", "timeout_ms"],
      "additionalProperties": false,
      "properties": {
        "failure_threshold": { "type": "integer", "minimum": 1, "maximum": 100 },
        "reset_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "half_open_max_requests": { "type": "integer", "minimum": 1, "maximum": 100 },
        "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 300000 }
      }
    },
    "environmentEntry": {
      "type": "object",
      "required": ["extends", "overrides"],
      "additionalProperties": false,
      "properties": {
        "extends": {
          "type": "array",
          "items": { "type": "string", "enum": ["global", "development", "production", "ci"] }
        },
        "overrides": {
          "type": "object",
          "patternProperties": {
            "^[a-z_]+\\.{1}[a-z_]+$": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "description": { "type": "string" }
      }
    }
  }
}
