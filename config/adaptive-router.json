{
  "version": "1.0.0",
  "description": "Adaptive Router Dinámico — dynamic routing layer that learns from historical performance",
  "enabled": true,
  "minDataPoints": 3,
  "minConfidenceForOverride": 0.8,
  "maxOverrides": 20,
  "decayDays": 14,
  "outputDir": ".session/routing",
  "sources": {
    "skillUsage": true,
    "metricsDelegations": true,
    "corrections": true,
    "reflections": true,
    "knowledgeConcepts": true,
    "staticRouter": true
  },
  "routingTable": {
    "maxEntries": 50,
    "minSuccessRate": 0.3,
    "preferRecentOverrides": true
  },
  "autoApply": {
    "overridesToPipeline": true,
    "updateSkillRouter": false,
    "maxChangesPerRun": 3
  }
}
