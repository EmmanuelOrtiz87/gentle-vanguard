{
  "name": "Continue.dev - Gentle-Vanguard Workspace",
  "version": "2.1.0",
  "description": "Optimized with checks system per Continue.dev best practices (docs.continue.dev/checks/best-practices)",
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": ["serve", "--mcp"],
      "enabled": true
    },
    "engram": {
      "type": "stdio",
      "command": "engram",
      "args": ["mcp", "--tools=agent"],
      "enabled": true
    }
  },
  "experimental": {
    "modelRegistry": true
  }
}
