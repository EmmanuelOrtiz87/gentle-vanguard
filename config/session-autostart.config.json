{
  "version": "1.0.0",
  "name": "session-autostart-config",
  "description": "Configuration for session autostart pipeline - controls which steps run and their parameters",
  "pipeline": {
    "steps": [
      {
        "id": "tool-detection",
        "enabled": true,
        "script": "scripts/utilities/detect-tool.ps1",
        "args": "-AsJson",
        "required": false,
        "description": "Detect AI tool/agent and load tool-specific configuration"
      },
      {
        "id": "session-manager",
        "enabled": true,
        "script": "scripts/utilities/session-manager.ps1",
        "args": "-Mode AutoStart",
        "required": true,
        "phase": 0,
        "description": "Initialize session ID and create session file"
      },
      {
        "id": "session-cleanup",
        "enabled": true,
        "script": "src/session-cleanup-start.ts",
        "args": "-Quiet",
        "required": false,
        "description": "Flush caches, close orphans, reset state, generate compressed CLAUDE.min.md"
      },
      {
        "id": "github-bypass",
        "enabled": true,
        "script": "scripts/utilities/session/SESSION-MANAGEMENT/ensure-github-bypass.ps1",
        "args": "",
        "required": false,
        "description": "Ensure GitHub bypass policy for current user"
      },
      {
        "id": "notifications",
        "enabled": true,
        "script": "scripts/utilities/session/session-notification.ps1",
        "args": "-TimeZone \"Argentina Standard Time\" -PeakStart 9 -PeakEnd 15 -Region \"Argentina\"",
        "required": false,
        "description": "Time-based peak hour notifications"
      },
      {
        "id": "auth-session",
        "enabled": false,
        "script": "scripts/utilities/auth-session.ps1",
        "args": "",
        "required": false,
        "description": "Authenticate owner for restricted operations (requires manual trigger with -ApiKey or -UseSecurityQuestions)",
        "note": "Disabled by default - auth is demand-driven, not at session start. Enable if session-level auth is required."
      },
      {
        "id": "engram-policy",
        "enabled": true,
        "script": "scripts/gentle-vanguard/engram-policy.ps1",
        "args": "-Action enforce",
        "required": true,
        "description": "Verify Engram is installed and running"
      },
      {
        "id": "token-budget",
        "enabled": true,
        "script": "src/token-budget-guard.ts",
        "args": "-Task session-start -Risk low -Record -ActualPromptTokens 0 -ActualCompletionTokens 0",
        "required": false,
        "description": "Record session start for token budget tracking"
      },
      {
        "id": "engram-integrity",
        "enabled": true,
        "script": "src/engram-integrity-check.ts",
        "args": "-Mode status -Quiet",
        "required": false,
        "description": "Verificar integridad de Engram (SHA256 + SQLite + chunks) al inicio de sesion"
      },
      {
        "id": "engram-backup",
        "enabled": true,
        "lazy": true,
        "script": "scripts/utilities/ops/BACKUP-RESTORE/backup-engram.ps1",
        "args": "-Mode backup -Quiet",
        "required": false,
        "description": "Backup automatico de Engram (DB + sessions + SHA256 checksums) via backup-engram.ps1"
      },
      {
        "id": "engram-optimization",
        "enabled": true,
        "script": "scripts/utilities/OPTIMIZE/optimize-engram-usage.ps1",
        "args": "-ProjectName workspace_gentle_vanguard",
        "required": false,
        "description": "Optimize Engram memory usage"
      },
      {
        "id": "engram-auto-sync",
        "enabled": true,
        "script": "src/engram-auto-sync.ts",
        "args": "-Mode sync -Quiet",
        "required": false,
        "description": "Auto-synchronize Engram checksums if DB was modified (prevents hash mismatches)"
      },
      {
        "id": "cross-workspace-validation",
        "enabled": true,
        "script": "scripts/monitoring/cross-workspace-validator.ps1",
        "args": "-Detailed",
        "required": false,
        "description": "Validate cross-workspace consistency"
      },
      {
        "id": "security-orchestrator",
        "enabled": true,
        "script": "src/security-orchestrator.ts",
        "args": "init prompt",
        "required": true,
        "description": "Initialize Security Orchestrator with policy and privacy configs (TS)"
      },
      {
        "id": "skill-router",
        "enabled": true,
        "script": "scripts/utilities/skills/SKILL/skill-router.ps1",
        "args": "-Query \"session-start\"",
        "required": false,
        "description": "Verify skill router is active"
      },
      {
        "id": "karpathy-guidelines",
        "enabled": true,
        "script": "scripts/adaptive/karpathy-enforcer.ps1",
        "args": "-Trigger session-start -VerboseOutput",
        "required": false,
        "description": "Enforce Karpathy guidelines (Think, Simplicity, Surgical, Goal-Driven)"
      },
      {
        "id": "session-metrics-start",
        "enabled": true,
        "script": "scripts/utilities/session/session-metrics-tracker.ps1",
        "args": "-Action start",
        "required": false,
        "description": "Initialize session metrics tracking (tokens, tool calls, files)"
      },
      {
        "id": "session-scoring-init",
        "enabled": true,
        "script": "src/session-scoring.ts",
        "args": "-Action init",
        "required": false,
        "description": "Initialize quality scoring system with baseline metrics"
      },
      {
        "id": "session-scoring-start",
        "enabled": true,
        "script": "src/session-scoring.ts",
        "args": "-Action record -EventType session -Detail session-start -Success",
        "required": false,
        "description": "Record session-start event in quality scoring system"
      },
      {
        "id": "session-scoring-close",
        "enabled": false,
        "script": "src/session-scoring.ts",
        "args": "-Action record -EventType session -Detail session-close -Success",
        "required": false,
        "description": "Record session-close event in quality scoring system (enabled on session end)"
      },
      {
        "id": "token-metrics-init",
        "enabled": true,
        "script": "scripts/utilities/token/token-metrics-store.ps1",
        "args": "-Action init",
        "required": false,
        "description": "Initialize token metrics database for historical tracking"
      },
      {
        "id": "adaptive-opencode-profile",
        "enabled": true,
        "script": "scripts/utilities/profile/PROFILE-ADAPTIVE/adaptive-opencode-profile.ps1",
        "args": "-Mode Auto -TimeZone \"Argentina Standard Time\" -PeakStart 9 -PeakEnd 15",
        "required": false,
        "description": "Intelligent temporary OpenCode optimization with automatic restore when normalized"
      },
      {
        "id": "adaptive-codex-windsurf-profile",
        "enabled": true,
        "script": "scripts/utilities/profile/PROFILE-ADAPTIVE/adaptive-codex-windsurf-profile.ps1",
        "args": "-Mode Auto -TimeZone \"Argentina Standard Time\" -PeakStart 9 -PeakEnd 15",
        "required": false,
        "description": "Intelligent temporary Codex/Windsurf optimization with automatic restore when normalized"
      },
      {
        "id": "lefthook-verify",
        "enabled": true,
        "script": "scripts/utilities/lefthook-verify.ps1",
        "args": "",
        "required": false,
        "description": "Verify Lefthook CLI + hooks are installed (post-commit/post-merge for CodeGraph auto-sync)"
      },
      {
        "id": "codegraph-sync",
        "enabled": true,
        "script": "scripts/utilities/codegraph/codegraph-sync-autostart.ps1",
        "args": "",
        "required": false,
        "description": "Verify CodeGraph index freshness and sync if stale (\u003e30min old)"
      },
      {
        "id": "metrics-collection",
        "enabled": true,
        "lazy": true,
        "script": "scripts/metrics/collector.ps1",
        "args": "-Scope full -Quiet",
        "required": false,
        "description": "Auto-collect metrics after session start for live dashboard"
      },
      {
        "id": "dashboard-ws-start",
        "enabled": true,
        "lazy": true,
        "script": "scripts/utilities/dashboard/dashboard-ws-autostart.ps1",
        "args": "-Quiet",
        "required": false,
        "description": "Start React WebSocket metrics server with watchdog auto-recovery — serves LLM observability dashboard on port 8080/5173"
      },
      {
        "id": "post-autostart-summary",
        "enabled": true,
        "script": "src/post-autostart-summary.ts",
        "args": "-TimeZone \"Argentina Standard Time\" -PeakStart 9 -PeakEnd 15 -Region \"Argentina\"",
        "required": false,
        "description": "Generate startup-summary.json with peak hour, session ID, workspace state"
      },
      {
        "id": "knowledge-base-init",
        "enabled": true,
        "lazy": true,
        "script": "scripts/utilities/knowledge-base/knowledge-base-autoinit.ps1",
        "args": "-Quiet",
        "required": false,
        "description": "Initialize Knowledge Base vault, validate structure, and run full sync with Engram/documents"
      },
      {
        "id": "skill-recommendation",
        "enabled": true,
        "lazy": true,
        "script": "src/skill-recommender.ts",
        "args": "-Proactive -TopN 3",
        "required": false,
        "description": "Recomienda skills relevantes basado en el contexto actual del workspace (git branch, archivos modificados, commits recientes)"
      },
      {
        "id": "skill-usage-scan",
        "enabled": true,
        "script": "scripts/skills/usage-tracker.ps1",
        "args": "",
        "required": false,
        "description": "Inicializa/escanea métricas de uso de skills al inicio de sesion"
      },
      {
        "id": "skill-nudge-check",
        "enabled": false,
        "script": "scripts/skills/skill-nudge.ps1",
        "args": "-Report",
        "required": false,
        "description": "Reporta nudges pendientes de skills al inicio (desactivado por defecto, corre al cerrar)"
      },
      {
        "id": "skill-size-check",
        "enabled": true,
        "lazy": true,
        "script": "scripts/utilities/skills/SKILL/check-skill-sizes.ps1",
        "args": "-WarnOnly",
        "required": false,
        "description": "Audita skills que exceden limites de tokens/lineas y recomienda split a references/"
      },
      {
        "id": "post-autostart-consistency-check",
        "enabled": true,
        "script": "src/post-autostart-summary.ts",
        "args": "",
        "required": false,
        "description": "Refresca startup-summary.json como ultimo paso para asegurar datos actuales post-pipeline"
      },
      {
        "id": "document-analysis-init",
        "enabled": true,
        "lazy": true,
        "script": "skills/document-analysis-skill/invoke-document-analysis.ps1",
        "args": "-Quiet",
        "required": false,
        "description": "Inicializar Document Analysis Skill - sidecar Python + conectores Jira/Confluence para analisis de requerimientos"
      },
      {
        "id": "token-notification-init",
        "enabled": true,
        "script": "scripts/utilities/token-usage-notifier.ps1",
        "args": "-Action init",
        "required": false,
        "description": "Inicializa sistema de notificaciones de tokens al inicio de sesion"
      },
      {
        "id": "json-validator-verify",
        "enabled": true,
        "script": "scripts/utilities/config/JSON/json-validator.ps1",
        "args": "-JsonString '{\"test\":\"ok\"}' -Context startup-verify",
        "required": false,
        "description": "Verifica que el validador JSON esta operativo al inicio de sesion"
      },
      {
        "id": "opencode-config-validate",
        "enabled": true,
        "script": "scripts/utilities/config/validate-opencode-config.ps1",
        "args": "-ConfigPath opencode.json",
        "required": false,
        "description": "Valida que opencode.json no tenga props no reconocidas por OpenCode (previene crash al iniciar)"
      },
      {
        "id": "validate-tool-configs",
        "enabled": true,
        "script": "scripts/utilities/config/validate-tool-configs.ps1",
        "args": "-Quiet",
        "required": false,
        "description": "Valida tool configs (.windsurf, .continue, .clinerules) contra schemas oficiales"
      },
      {
        "id": "maintenance-watchtower",
        "enabled": true,
        "lazy": true,
        "script": "src/maintenance-watchtower.ts",
        "args": "-Action autoheal -Quiet",
        "required": false,
        "description": "Health check completo + auto-healing de componentes caídos al inicio de sesión. Corre en background (lazy)."
      },
      {
        "id": "digest-generator",
        "enabled": true,
        "lazy": true,
        "script": "scripts/utilities/reporting/DIGEST/digest-generator.ps1",
        "args": "-Mode status -Show",
        "required": false,
        "description": "Genera digest de inicio de sesion con health, feedback trends, proposals pendientes"
      },
      {
        "id": "fine-tuning-data-collect",
        "enabled": true,
        "lazy": true,
        "script": "scripts/utilities/FINE-TUNING/ft-data-collector.ps1",
        "args": "-Source all -Force",
        "required": false,
        "description": "Auto-colecta datos de sesiones, engram, skills para fine-tuning dataset"
      },
      {
        "id": "judgment-day-correction",
        "enabled": true,
        "script": "src/correction-rules-engine.ts",
        "args": "-Mode check -Quiet",
        "required": false,
        "lazy": true,
        "description": "Execute auto-correction rules based on session quality scoring (Phase 1 v4.0)"
      },
      {
        "id": "cloud-connectors-init",
        "enabled": true,
        "lazy": true,
        "script": "src/hybrid-executor.ts",
        "args": "",
        "required": false,
        "description": "Initialize cloud connectors — validates config, checks circuit breaker states (TS)"
      },
      {
        "id": "cloud-connectors-metrics",
        "enabled": true,
        "lazy": true,
        "script": "src/token-budget-guard.ts",
        "args": "-Task cloud-metrics -Risk low -Record -ActualPromptTokens 0 -ActualCompletionTokens 0",
        "required": false,
        "description": "Ship cloud connector metrics (executions, cost, latency) to dashboard metrics pipeline (Phase 1.2)"
      },
      {
        "id": "tracing-init",
        "enabled": true,
        "lazy": true,
        "script": "src/tracing-instrument.ts",
        "args": "-Action start -SpanName session-start -ServiceName gentle-vanguard -Quiet",
        "required": false,
        "description": "Initialize distributed tracing span for this session — sends OTLP to collector (Phase 1.3)"
      },
      {
        "id": "checkpoint-auto-create",
        "enabled": true,
        "lazy": true,
        "script": "src/checkpoint-manager.ts",
        "args": "create",
        "required": false,
        "description": "Auto-create session state checkpoint at session start for rollback safety (TS)"
      },
      {
        "id": "audit-pipeline-init",
        "enabled": true,
        "lazy": true,
        "script": "src/audit-pipeline.ts",
        "args": "-Action log -EventType session.start -Component system -Operation autostart -Actor system -Status success -Message Session-autostart-pipeline-initialized -Quiet",
        "required": false,
        "description": "Log session start in the audit pipeline for SOC2/GDPR compliance (Phase 3)"
      },
      {
        "id": "event-sourcing-init",
        "enabled": true,
        "lazy": true,
        "script": "src/event-sourcing.ts",
        "args": "-Action append -AggregateId session-autostart -EventType session.started -EventData \u0027{}\u0027 -Quiet",
        "required": false,
        "description": "Record session start event in append-only event store for traceability (Phase 5)"
      },
      {
        "id": "post-session-learning",
        "enabled": true,
        "lazy": true,
        "script": "src/post-autostart-summary.ts",
        "args": "-FinalReportMode",
        "required": false,
        "description": "Generate final session report + auto-learned patterns for next session"
      },
      {
        "id": "cost-tracker-init",
        "enabled": true,
        "script": "scripts/utilities/telemetry/TELEMETRY-METRICS/cost-tracker.ps1",
        "args": "-Action status -Quiet",
        "required": false,
        "description": "Initialize cost tracking and show daily budget status at session start"
      },
      {
        "id": "planning-estimator-verify",
        "enabled": true,
        "lazy": true,
        "script": "scripts/utilities/planning/planning-estimator.ps1",
        "args": "-Action report -TaskType feature -Complexity 1 -FilesChanged 1 -LinesChanged 10 -Quiet",
        "required": false,
        "description": "Verify planning estimator is operational at session start"
      },
      {
        "id": "engram-auto-compact",
        "script": "scripts/utilities/memory/ENGRAM/engram-auto-compact.ps1",
        "args": "-Quiet -RetentionDays 90",
        "lazy": true,
        "enabled": true,
        "description": "Auto-compact old engram observations (>90 days)"
      },
      {
        "id": "ml-embeddings-incremental",
        "script": "scripts/utilities/agents/AUTO-DELEGATION/skill-embedder-incremental.ps1",
        "args": "-Quiet",
        "lazy": true,
        "enabled": true,
        "description": "Incrementally update skill embeddings on session start"
      },
      {
        "id": "maintenance-auto-prune",
        "script": "src/checkpoint-manager.ts",
        "args": "prune",
        "lazy": true,
        "enabled": true,
        "required": false,
        "description": "Auto-prune old checkpoints (>14 days), compact event store, clean graphify snapshots on session start"
      },
      {
        "id": "tenant-context",
        "enabled": true,
        "script": "scripts/utilities/TENANT/tenant-context.ps1",
        "args": "-Action get",
        "lazy": true,
        "required": false,
        "description": "Resolve tenant context (multi-tenant isolation v5.1)"
      },
      {
        "id": "eval-quality-gate",
        "enabled": true,
        "lazy": true,
        "script": "scripts/utilities/EVAL/eval-runner.ps1",
        "args": "-Suite codegraph-search -Export",
        "required": false,
        "description": "Run eval quality gates on core skills (v5.1)"
      },
      {
        "id": "self-heal-status",
        "enabled": true,
        "lazy": true,
        "script": "scripts/utilities/CI/ci-rollback-engine.ps1",
        "args": "-Action status",
        "required": false,
        "description": "Check CI/CD self-healing status (v5.1)"
      },
      {
        "id": "auto-code-review",
        "enabled": true,
        "lazy": true,
        "script": "scripts/utilities/EVOLVE/auto-code-review.ps1",
        "args": "-Action pre-commit",
        "required": false,
        "description": "Autonomous code review on staged files (v6.0)"
      },
      {
        "id": "mcp-gateway-init",
        "enabled": true,
        "lazy": true,
        "script": "src/mcp-gateway.ts",
        "args": "-Action start -Quiet",
        "required": false,
        "description": "Start MCP Native gateway at session start (v6.4)"
      },
      {
        "id": "db-health-check",
        "enabled": true,
        "lazy": true,
        "script": "scripts/recovery/db-health-check.ts",
        "args": "",
        "required": false,
        "description": "Validate SQLite database integrity (CodeGraph + Engram) on session start — auto-repairs WAL/REINDEX issues"
      }
    ],
    "onStepFailure": "continue",
    "requiredStepFailureAction": "exit"
  },
  "notifications": {
    "timeZone": "Argentina Standard Time",
    "peakStart": 9,
    "peakEnd": 15,
    "region": "Argentina"
  },
  "sessionDirectory": ".session",
  "sessionFilePattern": "session-{date}-{number:D2}.json",
  "sessionExpiryHours": 8,
  "auth": {
    "integrateWithAutostart": false,
    "requireAuthForRestrictedOps": true,
    "sessionAuthFile": ".workspace/config/session-auth.json",
    "ownerAuthFile": "config/owner-auth.json",
    "lockoutFile": "config/owner-auth.json.lock",
    "encryptedAuthFile": "config/owner-auth.json.enc"
  },
  "orphanSessionCleanup": {
    "enabled": true,
    "maxAgeHours": 24,
    "statusesToClean": ["active", "orphaned", "ended"],
    "description": "Clean up sessions left in \u0027active\u0027 status after maxAgeHours (crash recovery)"
  }
}
