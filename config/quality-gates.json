{
  "version": "2.0.0",
  "description": "Gentle-Vanguard Project — 29 Quality Gates (real enforcement via lefthook + CI)",
  "note": "Gates marked 'enforced: true' are actually run by lefthook or CI. Gates marked 'enforced: false' are aspirational/tools not installed.",
  "gates": [
    {
      "id": "pre-commit-format",
      "name": "Code Formatting (prettier)",
      "stage": "pre-commit",
      "enforced": true,
      "enforcer": "lefthook - format-check",
      "tool": "prettier",
      "required": true,
      "description": "Validate code formatting standards",
      "command": "prettier --check .",
      "failureAction": "block"
    },
    {
      "id": "pre-commit-json-lint",
      "name": "JSON Lint",
      "stage": "pre-commit",
      "enforced": true,
      "enforcer": "lefthook - json-lint",
      "tool": "src/json-lint.ts",
      "required": true,
      "description": "Validate JSON syntax",
      "command": "src/json-lint.ts",
      "failureAction": "block"
    },
    {
      "id": "pre-commit-workflow-lint",
      "name": "Workflow YAML Lint",
      "stage": "pre-commit",
      "enforced": true,
      "enforcer": "lefthook - workflow-lint",
      "tool": "src/workflow-lint.ts",
      "required": true,
      "description": "Validate GitHub Actions workflow syntax",
      "command": "src/workflow-lint.ts",
      "failureAction": "block"
    },
    {
      "id": "pre-commit-secretlint",
      "name": "Secret Scanning",
      "stage": "pre-commit",
      "enforced": true,
      "enforcer": "lefthook - secretlint",
      "tool": "secretlint",
      "required": true,
      "description": "Scan staged files for exposed secrets",
      "command": "secretlint --secretlintrc .secretlintrc.json {staged_files}",
      "failureAction": "block"
    },
    {
      "id": "pre-commit-trufflehog",
      "name": "TruffleHog Secret Scan",
      "stage": "pre-commit",
      "enforced": true,
      "enforcer": "lefthook - trufflehog-scan",
      "tool": "trufflehog",
      "required": false,
      "description": "Deep secret scanning via trufflehog (best-effort, exit 0 always)",
      "command": "trufflehog filesystem --no-verification --no-update .",
      "failureAction": "warn"
    },
    {
      "id": "pre-commit-opencode-validation",
      "name": "OpenCode Validation",
      "stage": "pre-commit",
      "enforced": true,
      "enforcer": "lefthook - opencode-validation",
      "tool": "pre-commit-opencode-validation.ts",
      "required": true,
      "description": "Validate opencode configuration compliance",
      "command": "npx tsx src/hooks/pre-commit-opencode-validation.ts",
      "failureAction": "block"
    },
    {
      "id": "pre-commit-validate-tool-configs",
      "name": "Tool Config Validation",
      "stage": "pre-commit",
      "enforced": true,
      "enforcer": "lefthook - validate-tool-configs",
      "tool": "validate-tool-configs.ts",
      "required": true,
      "description": "Validate tool configuration files",
      "command": "npx tsx src/core/validate-tool-configs.ts -Quiet",
      "failureAction": "block"
    },
    {
      "id": "pre-commit-normative-audit",
      "name": "Normative Audit",
      "stage": "pre-commit",
      "enforced": true,
      "enforcer": "lefthook - normative-audit",
      "tool": "normative-audit-hook.ts",
      "required": true,
      "description": "Enforce normative compliance against rules/",
      "command": "npx tsx src/hooks/normative-audit-hook.ts",
      "failureAction": "block"
    },
    {
      "id": "pre-commit-karpathy",
      "name": "Karpathy Enforcer",
      "stage": "pre-commit",
      "enforced": true,
      "enforcer": "lefthook - karpathy-enforcer",
      "tool": "karpathy-enforcer-hook.ts",
      "required": true,
      "description": "Enforce Karpathy coding guidelines",
      "command": "npx tsx src/hooks/karpathy-enforcer-hook.ts",
      "failureAction": "block"
    },
    {
      "id": "pre-commit-accent-check",
      "name": "Markdown Accent Check",
      "stage": "pre-commit",
      "enforced": true,
      "enforcer": "lefthook - markdown-accent-check",
      "tool": "markdown-accent-check-hook.ts",
      "required": true,
      "description": "Check for accent/internationalization issues in markdown",
      "command": "npx tsx src/hooks/markdown-accent-check-hook.ts -StagedFiles {staged_files}",
      "failureAction": "block"
    },
    {
      "id": "pre-commit-emoji-detector",
      "name": "Emoji Detector",
      "stage": "pre-commit",
      "enforced": true,
      "enforcer": "lefthook - emoji-detector",
      "tool": "emoji-detector-hook.ts",
      "required": true,
      "description": "Detect emoji usage in PowerShell scripts",
      "command": "npx tsx src/hooks/emoji-detector-hook.ts -StagedFiles {staged_files}",
      "failureAction": "block"
    },
    {
      "id": "pre-commit-sensitive-files",
      "name": "Sensitive Files Check",
      "stage": "pre-commit",
      "enforced": true,
      "enforcer": "lefthook - sensitive-files-check",
      "tool": "sensitive-files-check-hook.ts",
      "required": true,
      "description": "Check for sensitive files being committed",
      "command": "npx tsx src/hooks/sensitive-files-check-hook.ts -StagedFiles {staged_files}",
      "failureAction": "block"
    },
    {
      "id": "pre-commit-skill-scan",
      "name": "Skill Security Scan",
      "stage": "pre-commit",
      "enforced": true,
      "enforcer": "lefthook - skill-scan",
      "tool": "src/scan-skill-hook.ts",
      "required": true,
      "description": "Security scan for skill files",
      "command": "npx tsx src/scan-skill-hook.ts -StagedFiles {staged_files}",
      "failureAction": "block"
    },
    {
      "id": "commit-msg-commitlint",
      "name": "Commit Message Lint",
      "stage": "commit-msg",
      "enforced": true,
      "enforcer": "lefthook - commitlint",
      "tool": "commitlint.ts",
      "required": true,
      "description": "Validate commit message format",
      "command": "npx tsx src/hooks/commitlint.ts {1}",
      "failureAction": "block"
    },
    {
      "id": "commit-msg-session-track",
      "name": "Session Tracking",
      "stage": "commit-msg",
      "enforced": true,
      "enforcer": "lefthook - commit-msg-session-track",
      "tool": "commit-msg-session-track-hook.ts",
      "required": true,
      "description": "Track sessions via commit messages",
      "command": "npx tsx src/hooks/commit-msg-session-track-hook.ts -CommitMsgFile {1}",
      "failureAction": "warn"
    },
    {
      "id": "post-commit-codegraph",
      "name": "CodeGraph Sync",
      "stage": "post-commit",
      "enforced": true,
      "enforcer": "lefthook - codegraph-sync",
      "tool": "src/codegraph-post-modification-sync.ts",
      "required": true,
      "description": "Sync codegraph index after commit",
      "command": "npx tsx src/codegraph-post-modification-sync.ts -Trigger post-commit -Force",
      "failureAction": "warn"
    },
    {
      "id": "post-commit-hashline",
      "name": "Hashline Snapshot",
      "stage": "post-commit",
      "enforced": true,
      "enforcer": "lefthook - hashline-snapshot",
      "tool": "hashline-snapshot-hook.ts",
      "required": false,
      "description": "Snapshot hashline after commit",
      "command": "npx tsx src/infrastructure/hashline-snapshot-hook.ts",
      "failureAction": "warn"
    },
    {
      "id": "pre-push-audit",
      "name": "Audit Sweep",
      "stage": "pre-push",
      "enforced": true,
      "enforcer": "lefthook - audit-check",
      "tool": "gv.ts",
      "required": true,
      "description": "Quick audit sweep before push",
      "command": "npx tsx src/gv.ts -Scope quick",
      "failureAction": "block"
    },
    {
      "id": "pre-push-npm-audit",
      "name": "npm Audit",
      "stage": "pre-push",
      "enforced": true,
      "enforcer": "lefthook - npm-audit",
      "tool": "npm-audit-pre-push.ts",
      "required": true,
      "description": "Check dependency vulnerabilities",
      "command": "npx tsx src/infrastructure/npm-audit-pre-push.ts -AuditLevel moderate",
      "failureAction": "warn"
    },
    {
      "id": "pre-push-orchestrator",
      "name": "Orchestrator Auto-Fix",
      "stage": "pre-push",
      "enforced": true,
      "enforcer": "lefthook - orchestrator-auto-fix",
      "tool": "src/orchestrate-auto-fix.ts",
      "required": false,
      "description": "Auto-fix detected issues before push",
      "command": "npx tsx src/orchestrate-auto-fix.ts -Fix",
      "failureAction": "warn"
    },
    {
      "id": "ci-lint",
      "name": "ESLint (root)",
      "stage": "ci",
      "enforced": true,
      "enforcer": "CI via pnpm lint",
      "tool": "eslint",
      "required": true,
      "description": "ESLint for root TypeScript files",
      "command": "eslint scripts/**/*.ts src/**/*.ts --max-warnings 0",
      "failureAction": "block"
    },
    {
      "id": "ci-typecheck",
      "name": "TypeScript Type Check (root)",
      "stage": "ci",
      "enforced": true,
      "enforcer": "CI via pnpm typecheck",
      "tool": "typescript",
      "required": true,
      "description": "tsc --noEmit for root",
      "command": "tsc --noEmit",
      "failureAction": "block"
    },
    {
      "id": "ci-format",
      "name": "Code Format Check (root)",
      "stage": "ci",
      "enforced": true,
      "enforcer": "CI via pnpm format:check",
      "tool": "prettier",
      "required": true,
      "description": "Prettier format check for markdown/json/yml/yaml",
      "command": "prettier --check **/*.{md,json,yml,yaml}",
      "failureAction": "block"
    },
    {
      "id": "ci-secretlint",
      "name": "Secret Lint (root)",
      "stage": "ci",
      "enforced": true,
      "enforcer": "CI via pnpm secretlint",
      "tool": "secretlint",
      "required": true,
      "description": "Full secret lint across repo",
      "command": "secretlint **/*.{json,yml,yaml,md,env,toml,xml} --secretlintrc .secretlintrc.json",
      "failureAction": "block"
    },
    {
      "id": "ci-tests",
      "name": "Test Suite (PowerShell)",
      "stage": "ci",
      "enforced": true,
      "enforcer": "CI via pnpm test",
      "tool": "Pester",
      "required": true,
      "description": "48 PowerShell tests (unit, integration, security, performance)",
      "command": "npx tsx src/gv.ts",
      "failureAction": "block"
    },
    {
      "id": "dashboard-ci-lint",
      "name": "Dashboard ESLint",
      "stage": "ci",
      "enforced": true,
      "enforcer": "dashboard-ts-ci.yml",
      "tool": "eslint",
      "required": true,
      "description": "ESLint for apps/web-dashboard TypeScript",
      "command": "pnpm lint",
      "failureAction": "block"
    },
    {
      "id": "dashboard-ci-build",
      "name": "Dashboard Build (vite + tsc)",
      "stage": "ci",
      "enforced": true,
      "enforcer": "dashboard-ts-ci.yml",
      "tool": "typescript + vite",
      "required": true,
      "description": "TypeScript compile + Vite production build for web-dashboard",
      "command": "tsc && vite build",
      "failureAction": "block"
    },
    {
      "id": "governance-sdd-spec-validation",
      "name": "SDD Spec Validation",
      "stage": "governance",
      "enforced": false,
      "enforcer": "not enforced — script may not exist",
      "tool": "src/check-sdd-gate.ts",
      "required": false,
      "description": "Validate SDD spec status for feature branches",
      "command": "src/check-sdd-gate.ts",
      "failureAction": "block"
    },
    {
      "id": "deploy-readiness",
      "name": "Production Readiness",
      "stage": "deploy",
      "enforced": false,
      "enforcer": "not enforced — no deploy pipeline defined",
      "tool": "custom",
      "required": false,
      "description": "Verify production readiness",
      "failureAction": "block"
    }
  ],
  "stages": {
    "pre-commit": {
      "description": "Checks run by lefthook before every commit",
      "order": 1,
      "required": true
    },
    "commit-msg": {
      "description": "Commit message validation by lefthook",
      "order": 2,
      "required": true
    },
    "post-commit": {
      "description": "Post-commit tasks run by lefthook",
      "order": 3,
      "required": false
    },
    "pre-push": { "description": "Pre-push checks run by lefthook", "order": 4, "required": true },
    "ci": {
      "description": "CI checks via pnpm scripts (lint, typecheck, format, secretlint, tests, build)",
      "order": 5,
      "required": true
    },
    "governance": {
      "description": "Governance checks — currently not enforced",
      "order": 6,
      "required": false
    },
    "deploy": {
      "description": "Deployment readiness — currently not enforced",
      "order": 7,
      "required": false
    }
  },
  "stats": {
    "totalGates": 29,
    "enforcedInLefthook": 19,
    "enforcedInCI": 7,
    "notEnforced": 3,
