{
  "$schema": "./tokens.schema.json",
  "version": "2.0.0",
  "description": "Gentle-Vanguard design tokens v2. Consolidates 4 divergent legacy token sets (assets/gv-design-system.css, BRAND-GUIDELINES, UI-STANDARD-ECOSYSTEM, gv-analytics custom). See ADR-0026. Source of truth — all other formats (CSS, TS, SCSS) are generated from this file.",
  "mode": "dark-first",
  "color": {
    "primary": {
      "purple": "#a78bfa",
      "purpleDeep": "#7c3aed",
      "purpleSoft": "#c4b5fd",
      "cyan": "#22d3ee",
      "cyanDeep": "#06b6d4",
      "cyanSoft": "#67e8f9"
    },
    "surface": {
      "bg": "#121212",
      "bgDeep": "#0a0e17",
      "surface": "#1f2937",
      "surfaceRaised": "#273548",
      "surfaceOverlay": "rgba(31, 41, 55, 0.6)"
    },
    "text": {
      "primary": "#e5e7eb",
      "muted": "#9ca3af",
      "inverse": "#0a0e17"
    },
    "feedback": {
      "amber": "#f4bb4f",
      "red": "#ee6d75",
      "green": "#4ade80",
      "info": "#22d3ee"
    },
    "border": {
      "default": "rgba(156, 163, 175, 0.25)",
      "accent": "rgba(167, 139, 250, 0.18)",
      "accentStrong": "rgba(34, 211, 238, 0.5)"
    },
    "glow": {
      "purple": "rgba(168, 85, 247, 0.16)",
      "cyan": "rgba(34, 211, 238, 0.13)"
    },
    "gradient": {
      "primary": "linear-gradient(135deg, #a78bfa 0%, #22d3ee 100%)",
      "primarySubtle": "linear-gradient(135deg, rgba(167, 139, 250, 0.18) 0%, rgba(34, 211, 238, 0.18) 100%)",
      "text": "linear-gradient(135deg, #a78bfa 0%, #22d3ee 100%)"
    }
  },
  "typography": {
    "fontFamily": {
      "display": "'Orbitron', 'Rajdhani', 'Share Tech Mono', monospace",
      "body": "'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif",
      "mono": "'JetBrains Mono', 'Cascadia Code', Consolas, monospace"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800,
      "black": 900
    },
    "size": {
      "xs": "0.75rem",
      "sm": "0.8125rem",
      "base": "0.875rem",
      "md": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem",
      "5xl": "3rem"
    },
    "lineHeight": {
      "tight": 1.2,
      "snug": 1.35,
      "normal": 1.5,
      "relaxed": 1.65,
      "loose": 1.8
    },
    "letterSpacing": {
      "tight": "-0.025em",
      "snug": "-0.01em",
      "normal": "0",
      "wide": "0.05em",
      "wider": "0.1em",
      "widest": "0.2em"
    }
  },
  "spacing": {
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px"
  },
  "radius": {
    "none": "0",
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "xl": "18px",
    "2xl": "24px",
    "pill": "999px",
    "full": "9999px"
  },
  "elevation": {
    "0": "none",
    "sm": "0 1px 2px rgba(0, 0, 0, 0.3)",
    "md": "0 4px 12px rgba(0, 0, 0, 0.4)",
    "lg": "0 8px 24px rgba(0, 0, 0, 0.5)",
    "xl": "0 20px 60px rgba(0, 0, 0, 0.55)",
    "glow": "0 0 0 1px rgba(34, 211, 238, 0.15) inset, 0 8px 30px rgba(34, 211, 238, 0.35)"
  },
  "motion": {
    "duration": {
      "instant": "0ms",
      "fast": "150ms",
      "base": "280ms",
      "slow": "400ms",
      "slower": "600ms"
    },
    "easing": {
      "linear": "linear",
      "easeIn": "cubic-bezier(0.4, 0, 1, 1)",
      "easeOut": "cubic-bezier(0, 0, 0.2, 1)",
      "easeInOut": "cubic-bezier(0.4, 0, 0.2, 1)",
      "bounce": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  },
  "breakpoint": {
    "sm": "640px",
    "md": "1024px",
    "lg": "1280px",
    "xl": "1536px"
  },
  "zIndex": {
    "base": "0",
    "raised": "10",
    "sticky": "50",
    "overlay": "100",
    "modal": "200",
    "toast": "300",
    "max": "9999"
  },
  "animation": {
    "viewIn": "viewIn 0.28s ease-out forwards",
    "fadeIn": "fadeIn 0.2s ease-out forwards",
    "slideUp": "slideUp 0.28s cubic-bezier(0.4, 0, 0.2, 1) forwards",
    "scaleIn": "scaleIn 0.15s ease-out forwards"
  },
  "iconography": {
    "size": {
      "xs": "12px",
      "sm": "16px",
      "md": "20px",
      "lg": "24px",
      "xl": "32px",
      "2xl": "48px"
    }
  }
}
