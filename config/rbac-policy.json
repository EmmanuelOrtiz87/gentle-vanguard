{
  "version": "1.0.0",
  "description": "Role-Based Access Control policy for Gentle-Vanguard v4.0",
  "lastUpdated": "2026-06-19",

  "roles": {
    "owner": {
      "description": "Full system access — can manage config, secrets, and all operations",
      "permissions": [
        "read",
        "write",
        "admin",
        "delegate",
        "rollback",
        "delete",
        "configure",
        "audit"
      ]
    },
    "developer": {
      "description": "Standard development access — can create, execute, and review",
      "permissions": ["read", "write", "execute", "review", "delegate"],
      "forbidden": ["admin", "rollback", "delete", "configure", "audit"]
    },
    "operator": {
      "description": "Operations access — can monitor, start sessions, view health",
      "permissions": ["read", "execute", "monitor"],
      "forbidden": ["write", "admin", "delete", "configure", "delegate", "rollback"]
    },
    "viewer": {
      "description": "Read-only access for dashboards and reporting",
      "permissions": ["read"],
      "forbidden": ["write", "execute", "admin", "delete", "configure"]
    },
    "ai-agent": {
      "description": "Autonomous agent access — restricted to safe operations",
      "permissions": ["read", "execute", "delegate"],
      "forbidden": ["admin", "delete", "configure", "rollback"],
      "rateLimit": 30,
      "requireHumanInLoop": ["delegate", "rollback"]
    }
  },

  "resources": {
    "session": {
      "actions": ["start", "end", "read", "write"],
      "defaultRole": "developer"
    },
    "config": {
      "actions": ["read", "write", "delete"],
      "defaultRole": "owner"
    },
    "skills": {
      "actions": ["read", "execute", "create", "delete", "publish"],
      "defaultRole": "developer"
    },
    "secrets": {
      "actions": ["read", "write", "rotate"],
      "defaultRole": "owner"
    },
    "audit": {
      "actions": ["read", "export", "rotate"],
      "defaultRole": "owner"
    },
    "checkpoints": {
      "actions": ["create", "restore", "delete", "list"],
      "defaultRole": "developer",
      "restoreRequiresRole": "owner"
    },
    "dashboard": {
      "actions": ["view", "configure", "export"],
      "defaultRole": "viewer"
    }
  },

  "policies": {
    "humanInTheLoop": {
      "enabled": true,
      "actions": ["rollback", "delete-config", "rotate-secrets", "bulk-delete"],
      "timeoutSeconds": 300,
      "escalationContact": "owner"
    },
    "rateLimiting": {
      "enabled": true,
      "ai-agent": { "maxRequestsPerMinute": 30, "burst": 5 },
      "viewer": { "maxRequestsPerMinute": 60, "burst": 10 },
      "developer": { "maxRequestsPerMinute": 120, "burst": 20 },
      "operator": { "maxRequestsPerMinute": 60, "burst": 10 },
      "owner": { "maxRequestsPerMinute": 300, "burst": 50 }
    },
    "sessionTimeout": {
      "ai-agent": { "maxIdleMinutes": 15, "absoluteMaxHours": 4 },
      "viewer": { "maxIdleMinutes": 30, "absoluteMaxHours": 8 },
      "developer": { "maxIdleMinutes": 60, "absoluteMaxHours": 12 },
      "owner": { "maxIdleMinutes": 120, "absoluteMaxHours": 24 }
    },
    "audit": {
      "logAllAccess": true,
      "logAllConfigChanges": true,
      "logAllRoleChanges": true,
      "excludedRoles": ["viewer"]
    }
  },

  "defaultRole": "developer",
  "roleSource": "config/owner-auth.json",
  "cacheTimeoutMinutes": 5
}
