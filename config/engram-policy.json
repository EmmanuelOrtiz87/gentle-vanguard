{
  "engram": {
    "version": "1.20.0",
    "required": true,
    "autoSync": true,
    "backupEnabled": true,
    "retentionDays": 90,
    "integrityCheck": {
      "enabled": true,
      "frequency": "session-start"
    },
    "optimization": {
      "enabled": true,
      "autoCompact": true,
      "conflictScan": true
    }
  },
  "project": {
    "name": "gentle-vanguard",
    "defaultScope": "session"
  }
}
