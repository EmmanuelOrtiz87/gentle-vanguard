{
  "version": "1.0",
  "rules": {
    "high_token_usage": {
      "label": "High Token Usage",
      "metric": "tokens.used",
      "threshold": 100000,
      "severity": "warning",
      "unit": "tokens",
      "enabled": true
    },
    "budget_limit": {
      "label": "Budget Limit",
      "metric": "tokens.used",
      "threshold": 120000,
      "severity": "error",
      "unit": "tokens",
      "enabled": true
    },
    "high_latency_p95": {
      "label": "High Latency (p95)",
      "metric": "latency.p95",
      "threshold": 30000,
      "severity": "warning",
      "unit": "ms",
      "enabled": true
    },
    "high_error_rate": {
      "label": "High Error Rate",
      "metric": "latency.errorRate",
      "threshold": 0.05,
      "severity": "error",
      "unit": "%",
      "enabled": true
    },
    "low_feedback_score": {
      "label": "Low Feedback Score",
      "metric": "feedback.score",
      "threshold": 50,
      "severity": "warning",
      "unit": "%",
      "enabled": true,
      "direction": "below"
    },
    "low_sla": {
      "label": "SLA Below Target",
      "metric": "sla.sloCompliance",
      "threshold": 95,
      "severity": "error",
      "unit": "%",
      "enabled": true,
      "direction": "below"
    },
    "high_active_sessions": {
      "label": "High Active Sessions",
      "metric": "sessions.active",
      "threshold": 50,
      "severity": "info",
      "unit": "sessions",
      "enabled": true
    },
    "cost_spike": {
      "label": "Cost Spike Detected",
      "metric": "tokens.cost",
      "threshold": 0.5,
      "severity": "warning",
      "unit": "$",
      "enabled": true
    }
  }
}
