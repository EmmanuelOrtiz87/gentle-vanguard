{
  "name": "Gentle-Vanguard Development",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.22"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/powershell:1": {
      "version": "7.4"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.powershell",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "davidanson.vscode-markdownlint",
        "golang.go",
        "bierner.markdown-mermaid"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "eslint.validate": ["typescript", "javascript"],
        "files.associations": {
          "*.ps1": "powershell",
          "*.psm1": "powershell",
          "*.psd1": "powershell"
        }
      }
    }
  },
  "postCreateCommand": "pnpm install && pip install ruff pytest pytest-cov && go version",
  "mounts": [
    "source=${env:HOME}${env:USERPROFILE}/.gentle-vanguard,target=/home/vscode/.gentle-vanguard,type=bind"
  ],
  "remoteUser": "vscode"
}
