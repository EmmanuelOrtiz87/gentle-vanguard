{
  "hooks": {
    "preToolUse": [
      {
        "name": "json-validate",
        "trigger": "ToolCall",
        "command": "npx",
        "args": [
          "tsx",
          "C:/Workspace_local/gentle-vanguard/src/hooks/pre-tool-call-validate.ts",
          "{{tool}}",
          "{{args}}"
        ],
        "blocking": true,
        "onFailure": "warn"
      }
    ],
    "postToolUse": [
      {
        "name": "token-usage-log",
        "trigger": "ToolCall",
        "command": "npx",
        "args": [
          "tsx",
          "C:/Workspace_local/gentle-vanguard/src/hooks/post-tool-use-log.ts",
          "{{tool}}",
          "{{args}}"
        ],
        "blocking": false,
        "onFailure": "ignore"
      }
    ]
  }
}
