{
  "version": "1.0.0",
  "description": "Configuracion central de resiliencia para el stack Gentle-Vanguard",
  "global": {
    "default_timeout_seconds": 30,
    "default_retry_attempts": 3,
    "default_retry_delay_ms": 1000,
    "default_retry_backoff_factor": 2.0,
    "circuit_breaker_failure_threshold": 5,
    "circuit_breaker_reset_seconds": 60,
    "user_notification_enabled": true
  },
  "timeouts": {
    "agent_verify": {
      "timeout_seconds": 120,
      "retry_attempts": 1,
      "retry_delay_ms": 5000,
      "fallback_action": "notify_user",
      "description": "Agent verification - Pester puede tomar tiempo, aumentar timeout"
    },
    "psscriptanalyzer": {
      "timeout_seconds": 120,
      "retry_attempts": 1,
      "retry_delay_ms": 30000,
      "fallback_action": "warn_skip",
      "description": "PSScriptAnalyzer en 300+ scripts - timeout generoso"
    },
    "normative_audit": {
      "timeout_seconds": 60,
      "retry_attempts": 2,
      "retry_delay_ms": 2000,
      "fallback_action": "warn_continue",
      "description": "Auditoria normativa CI mode"
    },
    "engram_operation": {
      "timeout_seconds": 15,
      "retry_attempts": 3,
      "retry_delay_ms": 500,
      "retry_backoff_factor": 1.5,
      "fallback_action": "notify_user",
      "description": "Operaciones Engram (mem_save, mem_search)"
    },
    "git_operation": {
      "timeout_seconds": 30,
      "retry_attempts": 2,
      "retry_delay_ms": 2000,
      "fallback_action": "warn_continue",
      "description": "Operaciones git"
    },
    "pester_tests": {
      "timeout_seconds": 120,
      "retry_attempts": 1,
      "retry_delay_ms": 10000,
      "fallback_action": "notify_user",
      "description": "Pester test suite execution"
    }
  },
  "circuit_breakers": {
    "engram": {
      "failure_threshold": 3,
      "reset_seconds": 120,
      "half_open_max_requests": 1
    },
    "git_remote": {
      "failure_threshold": 5,
      "reset_seconds": 300,
      "half_open_max_requests": 2
    }
  },
  "user_notifications": {
    "format": "standard",
    "prefix": "[STACK]",
    "include_suggestions": true,
    "suggestions": {
      "timeout": [
        "Reintentar con mas tiempo",
        "Omitir este paso",
        "Continuar con lo demas",
        "Cancelar operacion"
      ],
      "circuit_breaker_open": [
        "Esperar y reintentar",
        "Usar modo offline",
        "Reportar falla persistente"
      ],
      "generic_failure": ["Reintentar", "Omitir", "Reportar"]
    }
  }
}
