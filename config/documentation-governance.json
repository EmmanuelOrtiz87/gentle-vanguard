{
  "documentation": {
    "version": "1.0",
    "lastUpdated": "2026-08-25",
    "governance": {
      "essentialGuides": [
        {
          "file": "docs/guides/README.md",
          "purpose": "Navigation hub",
          "maxLines": 500,
          "category": "navigation"
        },
        {
          "file": "docs/getting-started/README.md",
          "purpose": "New user entry point",
          "maxLines": 1500,
          "category": "guide"
        },
        {
          "file": "docs/guides/GITFLOW-QUICK-REFERENCE.md",
          "purpose": "GitFlow workflow quick reference and branch strategy",
          "maxLines": 1500,
          "category": "guide"
        },
        {
          "file": "rules/NORMATIVAS-CODE-QUALITY.md",
          "purpose": "Code and script quality standards (normativa)",
          "maxLines": 2000,
          "category": "standard"
        },
        {
          "file": "docs/guides/COMPATIBILITY-MATRIX.md",
          "purpose": "AI tool integration and compatibility matrix",
          "maxLines": 2000,
          "category": "guide"
        },
        {
          "file": "docs/guides/TROUBLESHOOTING-RUNBOOK.md",
          "purpose": "Common issues and solutions runbook",
          "maxLines": 1500,
          "category": "reference"
        },
        {
          "file": "docs/architecture/ARCHITECTURE.md",
          "purpose": "System architecture overview",
          "maxLines": 2000,
          "category": "architecture"
        },
        {
          "file": "docs/architecture/PROJECT-STRUCTURE.md",
          "purpose": "Project structure and component layout",
          "maxLines": 2000,
          "category": "architecture"
        }
      ],
      "redundantDocuments": [
        "docs/guides/GITHUB-ACTIONS-TROUBLESHOOTING.md",
        "docs/guides/PRE-DEPLOYMENT-CHECKLIST.md",
        "docs/guides/DEPLOYMENT-OPTIMIZATION-GUIDE.md",
        "docs/guides/REMAINING-SCRIPTS-TO-FIX.md",
        "docs/guides/QUICK-FIX-GUIDE.md",
        "docs/guides/SCRIPT-NORMALIZATION-COMPLETION-REPORT.md"
      ],
      "autoGeneratedReports": [
        "docs/audit/*.md",
        "docs/reports/*.md",
        "docs/metrics/*.md"
      ],
      "rules": {
        "maxFileSize": 2000,
        "requirePurpose": true,
        "requireExamples": true,
        "requireLinks": true,
        "noDuplication": true,
        "noTemporaryInfo": true,
        "noOutdatedContent": true
      },
      "maintenance": {
        "monthlyReview": {
          "checkDuplicates": true,
          "updateOutdated": true,
          "verifyLinks": true,
          "reviewSizes": true
        },
        "quarterlyAudit": {
          "consolidateRedundant": true,
          "archiveOldVersions": true,
          "updateExamples": true,
          "verifyCompleteness": true
        }
      }
    },
    "categories": {
      "navigation": {
        "description": "Navigation and index files",
        "maxFiles": 2
      },
      "guide": {
        "description": "User guides and how-to documents",
        "maxFiles": 10
      },
      "standard": {
        "description": "Standards and best practices",
        "maxFiles": 5
      },
      "architecture": {
        "description": "Architecture and design documents",
        "maxFiles": 5
      },
      "api": {
        "description": "API and protocol documentation",
        "maxFiles": 3
      },
      "reference": {
        "description": "Reference and troubleshooting",
        "maxFiles": 3
      }
    },
    "automation": {
      "validator": "[DEPRECATED] skills/documentation-manager.ps1 -> removed in TS migration",
      "actions": [
        "validate",
        "consolidate",
        "cleanup",
        "audit"
      ],
      "schedule": {
        "validation": "on-commit",
        "consolidation": "weekly",
        "cleanup": "monthly",
        "audit": "quarterly"
      }
    }
  }
}
