{
  "tool": "cursor",
  "displayName": "Cursor",
  "version": "latest",
  "preProcess": {
    "loadSkills": true,
    "skillTool": "skill",
    "autoLoad": true,
    "parallelExecution": true
  },
  "capabilities": ["parallel_execution", "mcp", "skills", "code_completion"],
  "configFiles": [".cursorrules", ".cursor/config.json"],
  "mcpBridge": "src/mcp-bridge.ts",
  "hooks": {
    "preToolCall": "src/pre-process-input.ts",
    "sessionStart": "scripts/utilities/session-autostart.cmd",
    "sessionStartPlatform": {
      "windows": "scripts/utilities/session-autostart.cmd",
      "linux": "bash ./scripts/utilities/session-autostart.sh",
      "macos": "bash ./scripts/utilities/session-autostart.sh"
    }
  }
}
