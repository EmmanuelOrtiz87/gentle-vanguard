{
  "sessionMetrics": {
    "version": "1.0.0",
    "tracking": {
      "enabled": true,
      "tokens": true,
      "toolCalls": true,
      "filesRead": true,
      "filesEdited": true,
      "skillsUsed": true,
      "errors": true,
      "warnings": true,
      "cacheHits": true,
      "cacheMisses": true,
      "qualityScore": true
    },
    "storage": {
      "directory": ".session/metrics",
      "format": "json",
      "rotation": "daily"
    },
    "retention": {
      "days": 90,
      "autoCleanup": true
    }
  }
}
