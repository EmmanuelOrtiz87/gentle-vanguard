{
  "$schema": "./deployment-prerequisites.schema.json",
  "version": "1.0.0",
  "imagePromotion": {
    "required": true,
    "manifestPath": "config/k8s/gentle-vanguard-deployment.yml",
    "requiredContainers": ["dashboard", "websocket", "mcp"],
    "digestInputs": {
      "dashboard": "GV_IMAGE_DIGEST_DASHBOARD",
      "websocket": "GV_IMAGE_DIGEST_WEBSOCKET",
      "mcp": "GV_IMAGE_DIGEST_MCP"
    }
  },
  "networkPolicy": {
    "required": true,
    "manifestPath": null,
    "requiredEvidence": ["GV_K8S_CNI_PROVIDER", "GV_K8S_NETWORKPOLICY_ENFORCED"]
  },
  "mcpSandbox": {
    "required": true,
    "policyPath": "config/mcp-execution-policy.json",
    "requiredEvidence": [
      "GV_MCP_SANDBOX_PROVIDER",
      "GV_MCP_SANDBOX_ENFORCED",
      "GV_MCP_SANDBOX_WORKSPACE"
    ]
  }
}
