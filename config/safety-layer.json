{
  "version": "1.0",
  "description": "AI Safety Layer configuration — guardrails, injection protection, risk scoring",
  "global": {
    "enabled": true,
    "blockOnViolation": true,
    "alertOnBlock": true,
    "requireHumanApproval": true,
    "auditLevel": "all"
  },
  "scoring": {
    "minAutoApproveScore": 0.7,
    "minAutoEscalateScore": 0.3,
    "signals": {
      "scopeImpactWeight": 0.25,
      "capabilityDriftWeight": 0.25,
      "patternViolationsWeight": 0.3,
      "historicalRiskWeight": 0.1,
      "similarityToBadWeight": 0.1
    }
  },
  "guardrails": {
    "constitutional": [
      "Cannot disable or modify safety systems",
      "Cannot self-delete or self-destruct",
      "Cannot escalate privileges beyond current scope",
      "Cannot mutate other agents without explicit approval",
      "Cannot introduce arbitrary code execution in prompts"
    ],
    "blockedPatterns": [
      { "pattern": "disable.*safety", "severity": "critical" },
      { "pattern": "ignore.*(previous|all).*instructions", "severity": "high" },
      { "pattern": "system.*override", "severity": "critical" },
      { "pattern": "bypass.*(security|safety)", "severity": "critical" },
      { "pattern": "remove.*(guardrail|constraint|limitation)", "severity": "critical" },
      { "pattern": "grant.*(root|admin|sudo).*access", "severity": "high" }
    ],
    "resourceLimits": {
      "maxFilesPerMutation": 10,
      "maxTokensPerPrompt": 32000,
      "maxNetworkCallsPerMutation": 5
    }
  },
  "injectionProtection": {
    "enabled": true,
    "strictness": "high",
    "blockOnDetection": true,
    "knownPatterns": [
      "ignore.*instructions",
      "DAN|do.anything.now",
      "you are free",
      "pretend.*you are",
      "jailbreak",
      "base64.*decode",
      "system.*message",
      "developer.*override",
      "forget.*(previous|all)"
    ]
  },
  "dashboard": {
    "endpoint": "/api/safety",
    "metricsPrefix": "safety",
    "updateIntervalMs": 10000
  }
}
