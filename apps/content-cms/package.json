{
  "name": "@gentle-vanguard/content-cms",
  "private": true,
  "version": "3.8.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:quality": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
