{
  "version": "1.0",
  "description": "Prometheus/Grafana monitoring config for Gentle-Vanguard (DISABLED - no Grafana server)",
  "enabled": false,
  "prometheus": {
    "scrapeInterval": "15s",
    "evaluationInterval": "15s",
    "scrapeConfigs": [
      {
        "jobName": "gentle-vanguard-dashboard",
        "staticConfigs": [{ "targets": ["localhost:8080"] }],
        "metricsPath": "/metrics",
        "scrapeInterval": "10s"
      },
      {
        "jobName": "gentle-vanguard-watchtower",
        "staticConfigs": [{ "targets": ["localhost:9090"] }],
        "metricsPath": "/metrics",
        "scrapeInterval": "60s"
      }
    ],
    "alertRules": [
      {
        "alert": "HighTokenUsage",
        "expr": "gentle_vanguard_tokens_used > 2100000",
        "for": "5m",
        "labels": { "severity": "warning" },
        "annotations": { "summary": "Token usage exceeds 70% of the 3M session budget" }
      },
      {
        "alert": "HighErrorRate",
        "expr": "gentle_vanguard_error_rate > 0.05",
        "for": "2m",
        "labels": { "severity": "critical" },
        "annotations": { "summary": "Error rate exceeds 5%" }
      },
      {
        "alert": "DashboardDown",
        "expr": "up{job=\"gentle-vanguard-dashboard\"} == 0",
        "for": "1m",
        "labels": { "severity": "critical" },
        "annotations": { "summary": "Dashboard is down" }
      }
    ]
  },
  "grafana": {
    "dashboardJson": "config/prometheus/grafana-dashboard.json",
    "datasource": {
      "name": "Prometheus",
      "type": "prometheus",
      "url": "http://localhost:9090",
      "access": "proxy"
    }
  },
  "exporter": {
    "port": 9100,
    "metricsPath": "/metrics",
    "collectors": ["process", "os"]
  },
  "deployScript": "src/prometheus-deploy.ts",
  "notes": [
    "1. Install Prometheus: https://prometheus.io/download/",
    "2. Install Grafana: https://grafana.com/grafana/download/",
    "3. Copy prometheus.yml to Prometheus config dir",
    "4. Import grafana-dashboard.json into Grafana",
    "5. Or use Docker: docker-compose -f config/prometheus/docker-compose.yml up -d"
  ]
}
