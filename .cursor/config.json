{
  "name": "Cursor - Gentle-Vanguard Workspace",
  "version": "2.0.0",
  "description": "Optimized for Cursor Agent Best Practices with modular rules, commands, and plans",
  "aiSettings": {
    "model": "claude-sonnet-4-5",
    "temperature": 0.3,
    "maxTokens": 4500,
    "localFirst": true
  },
  "toolPermissions": {
    "websearch": "deny",
    "codesearch": "deny",
    "webfetch": "deny"
  },
  "preProcessing": {
    "enabled": true,
    "mandatory": true,
    "script": "src/tools/pre-process-input.ts",
    "scriptArgs": { "UserInput": "USER_INPUT_HERE", "WorkspaceRoot": "." },
    "adaptiveSteps": {
      "enabled": true,
      "baseline": 24,
      "autoScale": true,
      "maxSteps": 80
    }
  },
  "rules": {
    "paths": [
      ".cursor/rules/core-workflow.md",
      ".cursor/rules/commands.md",
      ".cursor/rules/code-style.md"
    ]
  },
  "commands": {
    "paths": [".cursor/commands/"],
    "autoLoad": true
  },
  "plans": {
    "directory": ".cursor/plans/",
    "autoSave": true
  },
  "sessionManagement": {
    "autostart": "npm run session:autostart:detached",
    "project": "gentle-vanguard",
    "adaptiveSteps": {
      "enabled": true,
      "orchestrator": 24,
      "subagents": "auto"
    }
  },
  "language": { "default": "es", "technicalTerms": "en" },
  "governanceLayers": {
    "GOV": ["project-orchestrator-skill"],
    "DEV": ["sdd-lifecycle"],
    "QA": ["sdd-lifecycle"],
    "OPS": ["docker-devops-skill"],
    "DOC": ["documentation-governance"],
    "SESSION": ["session-workflow-skill"]
  },
  "mcpServers": {
    "gentle-vanguard-skills": {
      "command": "node",
      "args": ["dist/scripts/mcp/skill-server.js"],
      "description": "143+ skills vía MCP: list_skills, get_skill, search_skills"
    },
    "engram": {
      "command": "engram",
      "args": ["mcp", "--tools=agent"],
      "description": "Memoria persistente Engram vía MCP"
    },
    "codegraph": {
      "command": "codegraph",
      "args": ["serve", "--mcp"],
      "description": "CodeGraph: análisis de código indexado (588 nodos, 1197 edges)"
    }
  }
}
