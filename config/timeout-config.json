{
  "$schema": "config/timeout-config.schema.json",
  "version": "1.0.0",
  "description": "Configuración centralizada de timeouts para todo el stack Gentle-Vanguard",
  "global": {
    "default_timeout_ms": 30000,
    "default_retry_attempts": 3,
    "default_retry_delay_ms": 1000,
    "default_retry_backoff_factor": 2.0,
    "description": "Valores por defecto aplicados cuando no hay un timeout específico configurado"
  },

  "http_server": {
    "socket_timeout_ms": 120000,
    "headers_timeout_ms": 60000,
    "keep_alive_timeout_ms": 5000,
    "request_timeout_ms": 30000,
    "response_timeout_ms": 30000,
    "shutdown_graceful_ms": 10000,
    "shutdown_force_ms": 5000,
    "description": "Timeouts para servidores HTTP (dashboard WS, health API, gateways)"
  },

  "websocket": {
    "ping_interval_ms": 30000,
    "pong_timeout_ms": 10000,
    "handshake_timeout_ms": 5000,
    "reconnect_delay_base_ms": 1000,
    "reconnect_delay_max_ms": 30000,
    "reconnect_max_attempts": 10,
    "heartbeat_interval_ms": 5000,
    "description": "Timeouts para conexiones WebSocket (dashboard en tiempo real)"
  },

  "external_api": {
    "http_client_default_ms": 10000,
    "http_client_max_ms": 60000,
    "openai_request_ms": 60000,
    "anthropic_request_ms": 120000,
    "openrouter_request_ms": 60000,
    "ollama_request_ms": 120000,
    "github_api_ms": 30000,
    "jira_api_ms": 30000,
    "confluence_api_ms": 30000,
    "engram_operation_ms": 15000,
    "mcp_bridge_start_ms": 30000,
    "mcp_request_ms": 30000,
    "description": "Timeouts para llamadas a APIs externas y servicios cloud"
  },

  "process_execution": {
    "script_default_ms": 30000,
    "script_long_running_ms": 120000,
    "git_operation_ms": 15000,
    "npm_command_ms": 60000,
    "pnpm_command_ms": 60000,
    "tsc_typecheck_ms": 120000,
    "pipeline_step_ms": 120000,
    "health_check_ms": 60000,
    "watchdog_restart_delay_ms": 5000,
    "spawn_max_buffer_bytes": 1048576,
    "description": "Timeouts para ejecución de procesos (spawnSync, execSync, child_process)"
  },

  "pipeline": {
    "session_autostart_step_ms": 120000,
    "lazy_step_ms": 300000,
    "phase_timeout_ms": 600000,
    "required_step_ms": 60000,
    "orphan_cleanup_max_age_hours": 24,
    "session_expiry_hours": 8,
    "description": "Timeouts para la pipeline de sesión (session-autostart)"
  },

  "dashboard": {
    "ws_reconnect_interval_ms": 5000,
    "http_polling_interval_ms": 5000,
    "metrics_refresh_ms": 5000,
    "port_scan_timeout_ms": 3000,
    "watchdog_check_interval_ms": 5000,
    "watchdog_max_restarts": 10,
    "vite_dev_timeout_ms": 30000,
    "description": "Timeouts para el dashboard de observabilidad LLM"
  },

  "database": {
    "engram_db_query_ms": 5000,
    "engram_db_backup_ms": 60000,
    "engram_db_compact_ms": 120000,
    "sqlite_busy_timeout_ms": 5000,
    "sqlite_wal_checkpoint_ms": 10000,
    "codegraph_sync_ms": 60000,
    "description": "Timeouts para operaciones de base de datos (SQLite, Engram, CodeGraph)"
  },

  "cache": {
    "response_cache_ttl_ms": 3600000,
    "session_cache_ttl_ms": 300000,
    "metrics_cache_ttl_ms": 60000,
    "dns_cache_ttl_ms": 300000,
    "description": "TTLs y timeouts para sistemas de caché"
  },

  "session": {
    "idle_timeout_minutes": 60,
    "max_duration_minutes": 480,
    "auth_timeout_minutes": 15,
    "token_budget_daily": 120000,
    "token_soft_limit_pct": 70,
    "token_hard_limit_pct": 90,
    "description": "Timeouts de sesión de usuario y límites de token"
  },

  "hooks": {
    "pre_process_ms": 30000,
    "post_session_ms": 60000,
    "pre_commit_ms": 45000,
    "post_merge_ms": 60000,
    "execution_global_ms": 300000,
    "description": "Timeouts para git hooks (pre-commit, post-commit, post-merge)"
  },

  "monitoring": {
    "health_check_interval_ms": 30000,
    "metrics_collection_interval_ms": 60000,
    "alert_cooldown_ms": 300000,
    "log_rotation_interval_ms": 86400000,
    "cleanup_interval_ms": 3600000,
    "description": "Intervalos de monitoreo, colección de métricas y alertas"
  },

  "circuit_breaker": {
    "engram": {
      "failure_threshold": 3,
      "reset_seconds": 120,
      "half_open_max_requests": 1,
      "timeout_ms": 15000
    },
    "git_remote": {
      "failure_threshold": 5,
      "reset_seconds": 300,
      "half_open_max_requests": 2,
      "timeout_ms": 30000
    },
    "external_api": {
      "failure_threshold": 5,
      "reset_seconds": 60,
      "half_open_max_requests": 2,
      "timeout_ms": 10000
    },
    "description": "Configuración de circuit breakers con timeouts asociados"
  },

  "environments": {
    "development": {
      "extends": ["global"],
      "overrides": {
        "http_server.socket_timeout_ms": 300000,
        "pipeline.session_autostart_step_ms": 300000,
        "process_execution.script_long_running_ms": 300000
      },
      "description": "Timeouts más permisivos para desarrollo local"
    },
    "production": {
      "extends": ["global"],
      "overrides": {
        "http_server.socket_timeout_ms": 60000,
        "pipeline.session_autostart_step_ms": 60000,
        "process_execution.script_long_running_ms": 120000,
        "monitoring.health_check_interval_ms": 15000,
        "monitoring.alert_cooldown_ms": 120000
      },
      "description": "Timeouts más estrictos para producción"
    },
    "ci": {
      "extends": ["production"],
      "overrides": {
        "pipeline.session_autostart_step_ms": 120000,
        "process_execution.tsc_typecheck_ms": 180000,
        "hooks.pre_commit_ms": 60000,
        "hooks.pre_process_ms": 15000
      },
      "description": "Timeouts optimizados para CI/CD"
    }
  }
}
