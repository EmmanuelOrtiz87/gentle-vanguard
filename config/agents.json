  "routing": {
    "defaultAgent": "sdd-apply",
    "fallbackAgent": "self-diag-agent",
    "confidenceThreshold": 0.6
  },
  "execution": {
    "mode": "native",
    "preferNpxTsx": true,
    "timeoutMs": 300000,
    "maxRetries": 3,
    "parallel": false
  },
  "quality": {
    "requireTypecheck": true,
    "requireLint": true,
    "requireTests": true,
    "autoFix": false
  }
}
