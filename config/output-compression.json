{
  "$schema": "./output-compression-schema.json",
  "version": "1.0.0",
  "description": "Output compression configuration — controls response verbosity, abbreviation expansion, and token optimization for agent outputs",
  "last_updated": "2026-07-31",

  "profiles": {
    "ultra": {
      "name": "ultra",
      "description": "Aggressive compression with abbreviations and causal arrows. Minimal token usage.",
      "compressionLevel": 0.95,
      "maxLines": 5,
      "maxTokens": 300,
      "abbreviate": true,
      "causalNotation": true,
      "expandContractions": false,
      "removeFillers": true,
      "singleLineResponses": true,
      "guidelines": [
        "Use compact abbreviations (db/auth/config/req/res/fn/impl).",
        "Prefer X -> Y causal notation.",
        "One-word answers when enough.",
        "No preamble or postamble."
      ]
    },
    "lleno": {
      "name": "lleno",
      "description": "Compressed language with short fragments accepted. Adequate detail for task completion.",
      "compressionLevel": 0.7,
      "maxLines": 15,
      "maxTokens": 800,
      "abbreviate": true,
      "causalNotation": true,
      "expandContractions": false,
      "removeFillers": true,
      "singleLineResponses": false,
      "guidelines": [
        "Complete sentences preferred.",
        "Explain reasoning before actions.",
        "Provide sufficient detail to finish tasks in one pass."
      ]
    },
    "lite": {
      "name": "lite",
      "description": "Professional concise language with abbreviations; no filler. Optimized for token efficiency.",
      "compressionLevel": 0.85,
      "maxLines": 15,
      "maxTokens": 700,
      "abbreviate": true,
      "causalNotation": true,
      "expandContractions": false,
      "removeFillers": true,
      "singleLineResponses": false,
      "guidelines": [
        "Use abbreviations (db/auth/config/req/res/fn).",
        "No digressions.",
        "Keep sentences short.",
        "Focus on actionable output.",
        "Prefer X -> Y notation."
      ]
    },
    "simple": {
      "name": "simple",
      "description": "Minimum viable detail — no preamble, no postamble, no digressions.",
      "compressionLevel": 0.9,
      "maxLines": 10,
      "maxTokens": 500,
      "abbreviate": true,
      "causalNotation": true,
      "expandContractions": false,
      "removeFillers": true,
      "singleLineResponses": true,
      "guidelines": [
        "No preamble or postamble.",
        "No echoing user's question.",
        "One line answer then tools."
      ]
    }
  },

  "chatLevels": {
    "chat-compact": {
      "name": "chat-compact",
      "description": "Essential information only. Minimal verbosity.",
      "maxLines": 5,
      "maxTokens": 300,
      "enforceLineLimit": true,
      "enforceTokenLimit": true,
      "autoEscalate": false,
      "defaultProfile": "ultra"
    },
    "chat-balanced": {
      "name": "chat-balanced",
      "description": "Balanced detail with moderate verbosity.",
      "maxLines": 15,
      "maxTokens": 800,
      "enforceLineLimit": true,
      "enforceTokenLimit": true,
      "autoEscalate": true,
      "autoEscalateTriggers": ["multi-step", "implement", "refactor", "bug fix"],
      "defaultProfile": "lleno"
    },
    "chat-detailed": {
      "name": "chat-detailed",
      "description": "Full detail with explanations and context.",
      "maxLines": 50,
      "maxTokens": 1500,
      "enforceLineLimit": false,
      "enforceTokenLimit": false,
      "autoEscalate": false,
      "defaultProfile": "lite"
    }
  },

