{
  "defaultMode": "light",
  "detailedOnStartup": false,
  "runDemoOnFull": false,
  "primaryRuntime": "opencode",
  "fallbackToStack": true,
  "enableIdleAutoClose": true,
  "idleTimeoutMinutes": 60,
  "strictCompatibilityChecks": true,
  "optimization": {
    "handoffCompress": true,
    "preCompactHook": "src/pre-compact-hook.ts",
    "compressionRatio": 0.9,
    "adaptiveSkills": true,
    "tieredMemory": true,
    "engramOptimization": "src/knowledge/optimize-engram-usage.ts",
    "autoEngramContext": true
  },
  "deprecated": {
    "note": "Use opencode + 7-dimension review for native AI workflow."
  },
  "contextEfficiency": {
    "targetPercentage": 70,
    "autoCompactionThreshold": 15000,
    "reduceRedundancy": true,
    "referenceInsteadOfRepeat": true
  }
}
