{
  "tool": "claude-code",
  "displayName": "Claude Code",
  "version": "latest",
  "preProcess": {
    "loadSkills": true,
    "skillTool": "skill",
    "autoLoad": true
  },
  "capabilities": ["mcp", "skills", "subagents", "terminal", "hooks", "plugins"],
  "configFiles": ["CLAUDE.md", ".claude/settings.json", "AGENTS-fast.md", "config/plugins.json"],
  "hooks": {
    "preToolCall": "src/tools/pre-process-input.ts",
    "sessionStart": "npm run session:autostart:detached",
    "adaptiveProfile": "src/adaptive-opencode-profile.ts",
    "sessionStartPlatform": {
      "windows": "scripts/utilities/session-autostart.cmd",
      "linux": "bash ./scripts/utilities/session-autostart.sh",
      "macos": "bash ./scripts/utilities/session-autostart.sh"
    }
  }
}
