{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "imagePromotion", "networkPolicy", "mcpSandbox"],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "imagePromotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "manifestPath", "requiredContainers", "digestInputs"],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "manifestPath": {
          "type": "string",
          "minLength": 1
        },
        "requiredContainers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "digestInputs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "manifestPath", "requiredEvidence"],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "manifestPath": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "requiredEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "mcpSandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "policyPath", "requiredEvidence"],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "policyPath": {
          "type": "string",
          "minLength": 1
        },
        "requiredEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    }
  }
}
