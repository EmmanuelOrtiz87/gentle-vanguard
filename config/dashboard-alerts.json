{
  "version": "1.0",
  "rules": {
    "high_token_usage": {
      "label": "High Token Usage",
      "metric": "tokens.used",
      "threshold": 100000,
      "severity": "warning",
      "unit": "tokens",
      "enabled": true
    },
    "budget_limit": {
      "label": "Budget Limit",
      "metric": "tokens.used",
      "threshold": 120000,
      "severity": "error",
      "unit": "tokens",
      "enabled": true
    },
    "high_latency_p95": {
      "label": "High Latency (p95)",
      "metric": "latency.p95",
      "threshold": 30000,
      "severity": "warning",
      "unit": "ms",
      "enabled": true
    },
    "high_error_rate": {
      "label": "High Error Rate",
      "metric": "latency.errorRate",
      "threshold": 0.05,
      "severity": "error",
      "unit": "%",
      "enabled": true
    },
    "low_feedback_score": {
      "label": "Low Feedback Score",
      "metric": "feedback.score",
      "threshold": 50,
      "severity": "warning",
      "unit": "%",
      "enabled": true,
      "direction": "below"
    },
    "low_sla": {
      "label": "SLA Below Target",
      "metric": "sla.sloCompliance",
      "threshold": 95,
      "severity": "error",
      "unit": "%",
      "enabled": true,
      "direction": "below"
    },
    "high_active_sessions": {
      "label": "High Active Sessions",
      "metric": "sessions.active",
      "threshold": 50,
      "severity": "info",
      "unit": "sessions",
      "enabled": true
    },
    "cost_spike": {
      "label": "Cost Spike Detected",
      "metric": "tokens.cost",
      "threshold": 0.5,
      "severity": "warning",
      "unit": "$",
      "enabled": true
    },
    "safety_blocked_mutations": {
      "label": "Safety Blocks Detected",
      "metric": "safety.blockedCount",
      "threshold": 1,
      "severity": "error",
      "unit": "blocks",
      "enabled": true,
      "direction": "above"
    },
    "safety_low_score": {
      "label": "Low Safety Score",
      "metric": "safety.lastScore",
      "threshold": 0.5,
      "severity": "warning",
      "unit": "score",
      "enabled": true,
      "direction": "below"
    },
    "high_memory_usage": {
      "label": "High Memory Usage",
      "metric": "system.memory.usagePercent",
      "threshold": 80,
      "severity": "warning",
      "unit": "%",
      "enabled": true,
      "direction": "above"
    },
    "high_cpu_load": {
      "label": "High CPU Load",
      "metric": "system.cpu.loadAverage",
      "threshold": 2.0,
      "severity": "warning",
      "unit": "load average",
      "enabled": true,
      "direction": "above"
    },
    "low_disk_space": {
      "label": "Low Disk Space",
      "metric": "system.memory.free",
      "threshold": 100,
      "severity": "warning",
      "unit": "MB",
      "enabled": true,
      "direction": "below"
    },
    "high_response_time": {
      "label": "High Response Time",
      "metric": "mcp.performance.avgResponseTime",
      "threshold": 5000,
      "severity": "warning",
      "unit": "ms",
      "enabled": true
    },
    "low_cost_efficiency": {
      "label": "Low Cost Efficiency",
      "metric": "costInsights.savingsPct",
      "threshold": 20,
      "severity": "warning",
      "unit": "%",
      "enabled": true,
      "direction": "below"
    }
  }
}
