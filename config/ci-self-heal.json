{
  "version": "1.0",
  "description": "CI/CD Self-Healing configuration — retry, rollback, failure classification",
  "retry": {
    "maxRetries": 3,
    "baseDelayMs": 5000,
    "jitterMaxMs": 2000,
    "classify": {
      "transientPatterns": [
        "timeout",
        "rate limit",
        "network error",
        "connection refused",
        "503",
        "502",
        "500",
        "ECONNRESET",
        "ETIMEDOUT",
        "socket hang up"
      ],
      "securityPatterns": [
        "unauthorized",
        "forbidden",
        "invalid token",
        "CVE-",
        "security vulnerability",
        "authentication failed",
        "permission denied"
      ],
      "permanentPatterns": [
        "syntax error",
        "module not found",
        "cannot find module",
        "TypeError",
        "ReferenceError",
        "build failed",
        "test failed"
      ]
    }
  },
  "rollback": {
    "autoRollback": true,
    "maxRollbackAttempts": 2,
    "notifyChannels": ["dashboard", "audit"],
    "safeBranches": ["main", "master", "develop"],
    "requireApproval": false
  },
  "alerting": {
    "dashboardEndpoint": "/api/alerts",
    "severityMap": {
      "transient": "warning",
      "permanent": "error",
      "security": "critical"
    }
  }
}
