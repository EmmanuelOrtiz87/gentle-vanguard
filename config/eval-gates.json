{
  "version": "1.0",
  "description": "Eval quality gates — thresholds that block pipeline steps if score is below target",
  "defaultMinScore": 0.7,
  "defaultMinPassRate": 0.8,
  "gates": {
    "codegraph-search": {
      "minScore": 0.8,
      "minPassRate": 1.0,
      "blockPipeline": true,
      "alertOnFail": true
    },
    "engram-memory": {
      "minScore": 0.7,
      "minPassRate": 0.8,
      "blockPipeline": true,
      "alertOnFail": true
    },
    "dashboard-metrics": {
      "minScore": 0.9,
      "minPassRate": 1.0,
      "blockPipeline": true,
      "alertOnFail": true
    },
    "ci-self-heal": {
      "minScore": 0.8,
      "minPassRate": 1.0,
      "blockPipeline": false,
      "alertOnFail": false
    }
  }
}
