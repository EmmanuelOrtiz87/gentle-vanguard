  "mcp": {
    "codegraph": {
      "type": "local",
      "command": "codegraph serve --mcp",
      "enabled": true
    },
    "engram": {
      "type": "stdio",
      "command": "engram",
      "args": "mcp --tools=agent",
      "enabled": true
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": "-y chrome-devtools-mcp@latest --isolated",
      "enabled": true
    },
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": "-y @modelcontextprotocol/server-filesystem@latest C:\\Workspace_local",
      "enabled": true
    },
    "memory": {
      "type": "stdio",
      "command": "npx",
      "args": "-y @modelcontextprotocol/server-memory@latest",
      "enabled": true
    }
  },
  "tools": {
    "bash": true,
    "readFile": true,
    "writeFile": true,
    "editFile": true,
    "listFiles": true
  },
  "default_agent": "orchestrator",
  "share": "manual",
  "compaction": {
    "auto": true,
    "prune": true
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      ".engram-data/**",
      "tmp-session-debug/**",
      "logs/**",
      "session/**"
    ]
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "skill": "allow",
    "question": "allow",
    "todowrite": "allow",
    "lsp": "ask",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "ask",
    "doom_loop": "deny",
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "rg *": "allow",
      "Get-ChildItem *": "allow",
      "Test-Path *": "allow"
    },
    "task": {
      "*": "allow"
    }
  },
  "references": {}
}