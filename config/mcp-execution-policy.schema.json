{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["version", "skills"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "skills": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["command", "executable", "args"],
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "executable": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300000,
            "default": 60000
          },
          "maxOutputBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10485760,
            "default": 1048576
          },
          "network": {
            "type": "boolean",
            "default": false
          },
          "filesystem": {
            "type": "string",
            "enum": ["workspace", "broad"],
            "default": "workspace"
          }
        }
      }
    },
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    }
  }
}
