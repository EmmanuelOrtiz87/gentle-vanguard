{
  "version": "1.0",
  "description": "Azure Container Apps deployment config for Gentle-Vanguard (DISABLED - no Azure account)",
  "enabled": false,
  "azure": {
    "subscriptionId": "",
    "resourceGroup": "gentle-vanguard-rg",
    "location": "eastus",
    "environment": "gentle-vanguard-env"
  },
  "containerApp": {
    "name": "gentle-vanguard-dashboard",
    "image": "gentle-vanguard/dashboard:latest",
    "resources": {
      "cpu": 1,
      "memory": "2Gi"
    },
    "ingress": {
      "enabled": true,
      "targetPort": 8080,
      "external": true,
      "transport": "http"
    },
    "env": [
      { "name": "WS_PORT", "value": "8080" },
      { "name": "NODE_ENV", "value": "production" }
    ],
    "secrets": [{ "name": "engram-key", "value": "" }]
  },
  "registry": {
    "server": "gentlevanguard.azurecr.io",
    "username": "",
    "password": ""
  },
  "deployScript": "src/azure-deploy.ts",
  "notes": [
    "1. Set subscriptionId, registry username/password before deploying",
    "2. Run: az login && az acr login --name gentlevanguard",
    "3. Run: & ./src/azure-deploy.ts",
    "4. Or use GitHub Actions with Azure/login action"
  ]
}
