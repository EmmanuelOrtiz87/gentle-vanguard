{
  "version": "1.0.0",
  "name": "session-autostart-config",
  "description": "Configuration for session autostart pipeline - controls which steps run and their parameters",
  "pipeline": {
    "steps": [
      {
        "id": "tool-detection",
        "enabled": true,
        "script": "src/core/detect-tool.ts",
        "args": "--json",
        "required": false,
        "description": "Detect AI tool/agent and load tool-specific configuration (TS)"
      },
      {
        "id": "bootstrap-symlink",
        "enabled": true,
        "script": "src/bootstrap-symlink.ts",
        "args": "",
        "required": true,
        "phase": 0,
        "description": "Auto-create @gentle-vanguard/core symlink for module resolution"
      },
      {
        "id": "session-manager",
        "enabled": true,
        "script": "src/session-cleanup-start.ts",
        "args": "--quiet --skip-cache-flush --skip-compression",
        "required": true,
        "phase": 0,
        "description": "Initialize session ID and create session file (TS)"
      },
      {
        "id": "session-cleanup",
        "enabled": true,
        "script": "src/session-cleanup-start.ts",
        "args": "-Quiet",
        "required": false,
        "description": "Flush caches, close orphans, reset state, generate compressed CLAUDE.min.md"
      },
      {
        "id": "github-bypass",
        "enabled": true,
        "script": "src/ensure-github-bypass.ts",
        "args": "--owner EmmanuelOrtiz87 --branch develop",
        "required": false,
        "description": "Ensure GitHub bypass policy for current user (TS)"
      },
      {
        "id": "notifications",
        "enabled": true,
        "script": "src/session-notification.ts",
        "args": "--timezone \"America/Argentina/Buenos_Aires\" --peak-start 9 --peak-end 15 --region \"Argentina\"",
        "required": false,
        "description": "Time-based peak hour notifications (TS)"
      },
      {
        "id": "auth-session",
        "enabled": false,
        "script": "src/auth-session.ts",
        "args": "",
        "required": false,
        "description": "Authenticate owner for restricted operations (TS)",
        "note": "Disabled by default - auth is demand-driven, not at session start. Enable if session-level auth is required."
      },
      {
        "id": "engram-policy",
        "enabled": true,
        "script": "src/engram-policy.ts",
        "args": "",
        "required": true,
