{
  "version": "1.0",
  "rules": {
    "high_token_usage": {
      "label": "High Token Usage",
      "metric": "tokens.used",
      "threshold": 100000,
      "severity": "warning",
      "unit": "tokens",
      "enabled": true
    },
    "budget_limit": {
      "label": "Budget Limit",
      "metric": "tokens.used",
      "threshold": 120000,
      "severity": "error",
      "unit": "tokens",
      "enabled": true
    },
    "high_latency_p95": {
      "label": "High Latency (p95)",
      "metric": "latency.p95",
      "threshold": 30000,
      "severity": "warning",
      "unit": "ms",
      "enabled": true
    },
    "high_error_rate": {
      "label": "High Error Rate",
      "metric": "latency.errorRate",
      "threshold": 0.05,
      "severity": "error",
      "unit": "%",
      "enabled": true
    },
    "low_feedback_score": {
      "label": "Low Feedback Score",
      "metric": "feedback.score",
      "threshold": 50,
      "severity": "warning",
      "unit": "%",
      "enabled": true,
      "direction": "below"
    },
    "low_sla": {
      "label": "SLA Below Target",
      "metric": "sla.sloCompliance",
      "threshold": 95,
      "severity": "error",
      "unit": "%",
      "enabled": true,
      "direction": "below"
    },
    "high_active_sessions": {
      "label": "High Active Sessions",
      "metric": "sessions.active",
      "threshold": 50,
      "severity": "info",
      "unit": "sessions",
      "enabled": true
    },
    "cost_spike": {
      "label": "Cost Spike Detected",
      "metric": "tokens.cost",
      "threshold": 0.5,
      "severity": "warning",
      "unit": "$",
      "enabled": true
    },
    "safety_blocked_mutations": {
      "label": "Safety Blocks Detected",
      "metric": "safety.blockedCount",
      "threshold": 1,
      "severity": "error",
      "unit": "blocks",
      "enabled": true,
      "direction": "above"
    },
    "safety_low_score": {
      "label": "Low Safety Score",
      "metric": "safety.lastScore",
      "threshold": 0.5,
      "severity": "warning",
      "unit": "score",
      "enabled": true,
      "direction": "below"
    },
    "high_memory_usage": {
      "label": "High Memory Usage",
      "metric": "system.memory.usagePercent",
      "threshold": 80,
      "severity": "warning",
      "unit": "%",
      "enabled": true,
      "direction": "above"
    },
    "high_cpu_load": {
      "label": "High CPU Load",
      "metric": "system.cpu.loadAverage",
      "threshold": 2.0,
      "severity": "warning",
      "unit": "load average",
      "enabled": true,
      "direction": "above"
    },
    "low_disk_space": {
      "label": "Low Disk Space",
      "metric": "system.memory.free",
      "threshold": 100,
      "severity": "warning",
      "unit": "MB",
      "enabled": true,
      "direction": "below"
    },
    "high_response_time": {
      "label": "High Response Time",
      "metric": "mcp.performance.avgResponseTime",
      "threshold": 5000,
      "severity": "warning",
      "unit": "ms",
      "enabled": true
    },
    "low_cost_efficiency": {
      "label": "Low Cost Efficiency",
      "metric": "costInsights.savingsPct",
      "threshold": 20,
      "severity": "warning",
      "unit": "%",
      "enabled": true,
      "direction": "below"
    },

    "timeout_violation_rate": {
      "label": "High Timeout Violation Rate",
      "metric": "timeout.violationRate",
      "threshold": 0.1,
      "severity": "warning",
      "unit": "%",
      "enabled": true,
      "direction": "above",
      "description": "Más del 10% de las operaciones exceden su timeout"
    },
    "timeout_p95_violation": {
      "label": "P95 Latency Exceeds Timeout",
      "metric": "timeout.p95Ms",
      "threshold": 30000,
      "severity": "error",
      "unit": "ms",
      "enabled": true,
      "description": "La latencia p95 supera los 30s — degradación de performance"
    },
    "timeout_critical_violation": {
      "label": "Critical Timeout Violation",
      "metric": "timeout.criticalViolations",
      "threshold": 1,
      "severity": "error",
      "unit": "violations",
      "enabled": true,
      "direction": "above",
      "description": "Se detectó una violación crítica de timeout (2x threshold)"
    },
    "process_starvation": {
      "label": "Process Starvation Detected",
      "metric": "process_execution.avgDurationMs",
      "threshold": 60000,
      "severity": "warning",
      "unit": "ms",
      "enabled": true,
      "description": "El tiempo promedio de ejecución de procesos supera los 60s"
    },
    "socket_queue_backlog": {
      "label": "Socket Queue Backlog",
      "metric": "http_server.activeConnections",
      "threshold": 50,
      "severity": "warning",
      "unit": "connections",
      "enabled": false,
      "description": "Más de 50 conexiones activas simultáneas en el servidor HTTP"
    },
    "websocket_disconnect_rate": {
      "label": "High WebSocket Disconnect Rate",
      "metric": "websocket.reconnectRate",
      "threshold": 5,
      "severity": "warning",
      "unit": "reconnects/min",
      "enabled": true,
      "description": "Más de 5 reconexiones WebSocket por minuto"
    },
    "database_query_slow": {
      "label": "Slow Database Query",
      "metric": "database.avgQueryMs",
      "threshold": 2000,
      "severity": "warning",
      "unit": "ms",
      "enabled": true,
      "description": "Consultas a base de datos tardan más de 2s en promedio"
    },
    "cache_miss_rate": {
      "label": "High Cache Miss Rate",
      "metric": "cache.missRate",
      "threshold": 0.5,
      "severity": "info",
      "unit": "%",
      "enabled": false,
      "description": "Más del 50% de cache misses — posible bottleneck"
    },
    "pipeline_step_slow": {
      "label": "Slow Pipeline Step",
      "metric": "pipeline.stepAvgMs",
      "threshold": 30000,
      "severity": "warning",
      "unit": "ms",
      "enabled": true,
      "description": "Un paso de la pipeline está tardando más de 30s en promedio"
    },
    "session_expiry_risk": {
      "label": "Session Expiry Risk",
      "metric": "session.remainingMinutes",
      "threshold": 10,
      "severity": "info",
      "unit": "minutes",
      "enabled": true,
      "description": "Quedan menos de 10 minutos antes del expiry de sesión",
      "direction": "below"
    },

    "sqlite_skill_success_rate": {
      "label": "SQLite Skill Success Rate",
      "metric": "sqlite.contractPassRate",
      "threshold": 0.5,
      "severity": "warning",
      "unit": "%",
      "enabled": true,
      "direction": "below",
      "description": "Tasa de contratos exitosos en SQLite por debajo de 50%"
    },
    "sqlite_token_budget_usage": {
      "label": "SQLite Token Budget Usage",
      "metric": "sqlite.tokenTotalCost",
      "threshold": 0.05,
      "severity": "warning",
      "unit": "$",
      "enabled": true,
      "direction": "above",
      "description": "Costo total de tokens en SQLite supera $0.05"
    },
    "sqlite_routing_coverage": {
      "label": "SQLite Routing Coverage",
      "metric": "sqlite.routingTotalHits",
      "threshold": 5,
      "severity": "info",
      "unit": "hits",
      "enabled": true,
      "direction": "below",
      "description": "Pocos hits de enrutamiento — reglas infrautilizadas"
    }
  }
}
