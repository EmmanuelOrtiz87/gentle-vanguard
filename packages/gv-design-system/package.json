{
  "name": "@gentle-vanguard/design-system",
  "version": "2.0.0",
  "description": "Gentle-Vanguard native design system v2 Premium (official since 2026-09-02): tokens, components, MCP server, audit. Consolidates 4 divergent legacy systems. See ADR-0026 + docs/brand/BRAND-DECISION-2026-09-01.md.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./components.css": "./dist/components.css",
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./mcp": "./dist/mcp/index.js"
  },
  "files": [
    "dist",
    "DESIGN.md",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:tokens && npm run build:components && npm run build:mcp",
    "build:tokens": "tsx src/cli/build-tokens.ts",
    "build:components": "tsc -p tsconfig.json",
    "build:mcp": "tsc -p tsconfig.mcp.json",
    "dev": "tsc -w -p tsconfig.json",
    "audit": "impeccable detect src/ --json",
    "audit:app": "tsx src/cli/audit.ts",
    "sync": "tsx src/cli/sync.ts",
    "mcp:start": "tsx src/mcp/server.ts"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "react",
    "mcp",
    "gentle-vanguard",
    "ui",
    "tokens",
    "components"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "impeccable": "^3.6.0",
    "react": "^18.3.0",
    "tsx": "^4.23.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
