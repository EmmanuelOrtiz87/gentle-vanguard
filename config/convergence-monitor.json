{
  "version": "1.0.0",
  "description": "Convergence Monitor — tracks if the stack is converging, oscillating, or diverging over time",
  "enabled": true,
  "decisionStability": {
    "windowDays": 14,
    "maxConfigChangesBeforeAlert": 5,
    "minStabilityPeriods": 3
  },
  "improvementRate": {
    "enabled": true,
    "minDataPoints": 3,
    "improvementThreshold": 0.05,
    "degradationThreshold": -0.05
  },
  "divergence": {
    "enabled": true,
    "alertOnDivergence": true,
    "minDivergenceScore": 0.6,
    "consecutiveDivergencesToAlert": 2
  },
  "metrics": {
    "qualityScoreWeight": 0.3,
    "correctionRateWeight": 0.2,
    "patternRecurrenceWeight": 0.2,
    "configStabilityWeight": 0.15,
    "skillHealthWeight": 0.15
  },
  "outputDir": ".session/convergence"
}
