{
  "version": "1.0.0",
  "description": "Resilience policy for Gentle-Vanguard retry, fallback, notification, and circuit-breaker behavior. Timeout values are mirrored by config/timeout-config.json, which remains the source of truth for durations.",
  "global": {
    "default_retry_attempts": 3,
    "default_retry_delay_ms": 1000,
    "default_retry_backoff_factor": 2,
    "circuit_breaker_failure_threshold": 5,
    "circuit_breaker_reset_seconds": 60,
    "user_notification_enabled": true
  },
  "timeouts": {
    "agent_verify": {
      "timeout_seconds": 120,
      "retry_attempts": 2,
      "retry_delay_ms": 1000,
      "retry_backoff_factor": 2,
      "fallback_action": "warn_continue",
      "description": "Agent verification and lightweight agent runtime checks"
    },
    "psscriptanalyzer": {
      "timeout_seconds": 120,
      "retry_attempts": 1,
      "retry_delay_ms": 1000,
      "retry_backoff_factor": 2,
      "fallback_action": "warn_continue",
      "description": "PowerShell static analysis compatibility checks"
    },
    "normative_audit": {
      "timeout_seconds": 120,
      "retry_attempts": 1,
      "retry_delay_ms": 1000,
      "retry_backoff_factor": 2,
      "fallback_action": "warn_continue",
      "description": "Normative and governance audit steps"
    },
    "engram_operation": {
      "timeout_seconds": 15,
      "retry_attempts": 3,
      "retry_delay_ms": 1000,
      "retry_backoff_factor": 2,
      "fallback_action": "warn_continue",
      "description": "Engram memory and integrity operations"
    },
    "git_operation": {
      "timeout_seconds": 15,
      "retry_attempts": 2,
      "retry_delay_ms": 1000,
      "retry_backoff_factor": 2,
      "fallback_action": "warn_continue",
      "description": "Git commands used by hooks, sync, and status checks"
    },
    "pester_tests": {
      "timeout_seconds": 120,
      "retry_attempts": 1,
      "retry_delay_ms": 1000,
      "retry_backoff_factor": 2,
      "fallback_action": "warn_continue",
      "description": "Legacy Pester compatibility test execution"
    }
  },
  "circuit_breakers": {
    "engram": {
      "failure_threshold": 3,
      "reset_seconds": 120,
      "half_open_max_requests": 1
    },
    "git_remote": {
      "failure_threshold": 5,
      "reset_seconds": 300,
      "half_open_max_requests": 2
    },
    "external_api": {
      "failure_threshold": 5,
      "reset_seconds": 60,
      "half_open_max_requests": 2
    }
  },
  "user_notifications": {
    "format": "plain",
    "prefix": "[STACK]",
    "include_suggestions": true,
    "suggestions": {
      "timeout": [
        "Re-run the operation with a larger timeout",
        "Check whether the target service is already running",
        "Continue only when the step is non-required"
      ],
      "missing_dependency": [
        "Install or restore the missing dependency",
        "Run the related setup command",
        "Check config/session-autostart.config.json for the owning step"
      ],
      "generic": [
        "Inspect the step output",
        "Re-run the session autostart",
        "Escalate only if the required step continues failing"
      ]
    }
  }
}
