{
  "$schema": "../src/core/schemas/agents.json",
  "version": "1.0.0",
  "description": "Gentle-Vanguard Agent Configuration - Agnostic and Portable",
  "agents": {
    "sdd-explore": {
      "name": "sdd-explore",
      "description": "BA exploration agent — requirements gathering and analysis",
      "type": "subagent",
      "capability": "requirements-analysis",
      "model": "opencode/big-pickle",
      "fallbackModels": ["claude-haiku-4-5", "kimi-2-5"],
      "temperature": 0.7,
      "maxTokens": 4000,
      "maxSteps": 38,
      "executionCommand": "npx tsx src/agents/sdd-explore.ts",
      "script": "src/agents/sdd-explore.ts",
      "triggers": [
        "explore",
        "analyze requirements",
        "requirements gathering",
        "user story",
        "feature request",
        "ambiguous",
        "clarify"
      ],
      "permissions": {
        "read": ["*.md", "docs/**", "requirements/**"],
        "write": ["docs/requirements/**"],
        "websearch": false,
        "webfetch": false
      },
      "qualityGates": {
        "acceptanceCriteria": true,
        "edgeCasesDocumented": true,
        "stakeholdersIdentified": true
      }
    },
    "sdd-design": {
      "name": "sdd-design",
      "description": "SAD architecture design agent — system design and API contracts",
      "type": "subagent",
      "capability": "architecture-design",
      "model": "opencode/big-pickle",
      "fallbackModels": ["claude-haiku-4-5", "kimi-2-5"],
      "temperature": 0.3,
      "maxTokens": 4000,
      "maxSteps": 30,
      "executionCommand": "npx tsx src/agents/sdd-design.ts",
      "script": "src/agents/sdd-design.ts",
      "triggers": [
        "design",
        "architecture",
        "api contract",
        "system design",
        "component diagram",
        "data flow",
        "adr"
      ],
      "permissions": {
        "read": ["*.ts", "*.json", "docs/architecture/**"],
        "write": ["docs/architecture/**", "docs/decisions/**"],
        "websearch": false,
        "webfetch": false
      },
      "qualityGates": {
        "adrCreated": true,
        "apiContractsDefined": true,
        "dataModelsValidated": true
      }
    },
    "sdd-apply": {
      "name": "sdd-apply",
      "description": "DEV implementation agent — code generation and feature building",
      "type": "subagent",
      "capability": "implementation",
      "model": "opencode/big-pickle",
      "fallbackModels": ["claude-haiku-4-5", "kimi-2-5"],
      "temperature": 0.15,
      "maxTokens": 6000,
      "maxSteps": 52,
      "executionCommand": "npx tsx src/agents/sdd-apply.ts",
      "script": "src/agents/sdd-apply.ts",
      "triggers": ["implement", "code", "fix", "refactor", "build", "create", "update", "edit"],
      "permissions": {
        "read": ["**/*"],
        "write": ["**/*.{ts,js,json,md,yml,yaml}"],
        "websearch": false,
        "webfetch": false
      },
      "qualityGates": {
        "typecheck": true,
        "lint": true,
        "testsPass": true,
        "noSecrets": true
      }
    },
    "sdd-verify": {
      "name": "sdd-verify",
      "description": "QA verification agent — testing and validation",
      "type": "subagent",
      "capability": "verification",
      "model": "opencode/big-pickle",
      "fallbackModels": ["claude-haiku-4-5", "kimi-2-5"],
      "temperature": 0.1,
      "maxTokens": 4000,
      "maxSteps": 36,
      "executionCommand": "npx tsx src/agents/sdd-verify.ts",
      "script": "src/agents/sdd-verify.ts",
      "triggers": [
        "test",
        "verify",
        "validate",
        "quality check",
        "security scan",
        "regression",
        "test coverage"
      ],
      "permissions": {
        "read": ["**/*"],
        "write": ["tests/**"],
        "websearch": false,
        "webfetch": false
      },
      "qualityGates": {
        "typecheck": true,
        "lint": true,
        "testsPass": true,
        "securityCheck": true,
        "dashboardBuild": true
      }
    },
    "doc-agent": {
      "name": "doc-agent",
      "description": "Documentation agent — technical docs and guides",
      "type": "subagent",
      "capability": "documentation",
      "model": "opencode/big-pickle",
      "temperature": 0.4,
      "maxTokens": 4000,
      "maxSteps": 34,
      "executionCommand": "npx tsx src/agents/doc-agent.ts",
      "script": "src/agents/doc-agent.ts",
      "triggers": ["document", "doc", "readme", "adr", "guide", "tutorial"],
      "permissions": {
        "read": ["**/*.md", "docs/**"],
        "write": ["**/*.md", "docs/**"],
        "websearch": false,
        "webfetch": false
