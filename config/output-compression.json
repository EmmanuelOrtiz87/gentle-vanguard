  "causalNotation": {
    "enabled": true,
    "patterns": {
      "causes": ["->", "→", "=>", "⟹", "leads to", "results in", "causes"],
      "prevents": ["-x->", "⊸", "blocks", "prevents", "stops"],
      "enables": ["-o->", "⇢", "enables", "allows", "permits"],
      "depends": ["<-", "←", "<=", "⟸", "depends on", "requires", "needs"],
      "optional": ["~>", "⇝", "may lead to", "optionally", "could"],
      "sequence": ["->>", "↠", "then", "next", "followed by"],
      "parallel": ["||>", "⇉", "and", "concurrently", "in parallel"],
      "conditional": ["?>", "⇨", "if", "when", "in case"]
    },
    "preferSymbols": true
  },

