  subgraph INPUT["INPUT — Document Sources"]
    A[PDF]:::input
    B[DOCX]:::input
    C[XLSX]:::input
    D[PPTX]:::input
    E[MD / TXT]:::input
  end

  subgraph SIDECAR["LAYER 1 — Python Sidecar (extracted from Turnkey)"]
    OR[office_reader.py]:::python
    PR[pdf_reader.py]:::python
