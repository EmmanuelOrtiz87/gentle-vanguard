{
  "version": "1.0",
  "description": "Self-evolving agent configuration — mutation strategies, thresholds, safety guards",
  "global": {
    "enabled": true,
    "maxMutationsPerDay": 5,
    "requireHumanApprovalAfter": 10,
    "evalScoreThreshold": 0.8,
    "rollbackScoreDrop": 0.2,
    "cooldownMinutes": 60
  },
  "mutationStrategies": {
    "prompt-tuning": {
      "enabled": true,
      "weight": 0.5,
      "description": "Adjust system prompt based on error patterns (e.g., 'too verbose' -> add '-Concise')"
    },
    "skill-composition": {
      "enabled": true,
      "weight": 0.3,
      "description": "If no single skill solves the task, compose multiple skills via MCP bridge"
    },
    "tool-selection": {
      "enabled": true,
      "weight": 0.2,
      "description": "Learn which tools to prefer for which task types via reinforcement from eval score"
    }
  },
  "abTesting": {
    "enabled": true,
    "minDeltaToDeploy": 0.05,
    "minScoreToDeploy": 0.7,
    "trialRuns": 1
  },
  "safety": {
    "maxScoreDropBeforeRollback": 0.2,
    "blockedPatterns": ["delete.*file", "rm.*-rf", "drop.*table", "format.*disk"],
    "requireApprovalForPatterns": ["security.*policy", "permission.*change", "tenant.*config"]
  },
  "safetyIntegration": {
    "enabled": true,
    "layer": "v6.1",
    "configRef": "config/safety-layer.json",
    "guardrailsScript": "src/security/safety-guardrails.ts",
    "scorerScript": "src/mutation-safety-scorer.ts",
    "injectionGuardScript": "src/security/prompt-injection-guard.ts",
    "blockOnViolation": true,
    "escalateMediumRisk": true
  },
  "agents": {
    "codegraph-search": {
      "enabled": true,
      "evalSuite": "codegraph-search",
      "minScore": 0.8
    },
    "engram-memory": {
      "enabled": true,
      "evalSuite": "engram-memory",
      "minScore": 0.7
    },
    "dashboard-metrics": {
      "enabled": true,
      "evalSuite": "dashboard-metrics",
      "minScore": 0.9
    }
  }
}
