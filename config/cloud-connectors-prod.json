{
  "version": "1.0.0",
  "description": "Production Cloud Connectors configuration for Gentle-Vanguard v4.0",
  "lastUpdated": "2026-06-19",

  "aws": {
    "enabled": true,
    "region": "us-east-1",
    "functionName": "gentle-vanguard-skill-executor",
    "maxRetries": 3,
    "invocationType": "RequestResponse",
    "s3Bucket": "gentle-vanguard-sessions",
    "s3Prefix": "session-logs/",
    "circuitBreaker": {
      "failureThreshold": 5,
      "successThreshold": 2,
      "timeoutSeconds": 60
    },
    "costPerInvocation": 0.0000167,
    "credentialsSource": "env:AWS_ACCESS_KEY_ID,AWS_SECRET_ACCESS_KEY"
  },

  "azure": {
    "enabled": true,
    "functionUrl": "${AZURE_FUNCTION_URL}",
    "maxRetries": 3,
    "invocationType": "RequestResponse",
    "authMethods": ["functionKey", "bearerToken", "azureCLI"],
    "circuitBreaker": {
      "failureThreshold": 5,
      "successThreshold": 2,
      "timeoutSeconds": 60
    },
    "costPerInvocation": 0.00002,
    "credentialsSource": "env:AZURE_FUNCTION_KEY,AZURE_ACCESS_TOKEN"
  },

  "hybrid": {
    "enabled": true,
    "defaultStrategy": "cost",
    "preferredProvider": "auto",
    "fallbackEnabled": true,
    "metricsEnabled": true,
    "strategies": ["cost", "latency", "load"]
  },

  "metrics": {
    "outputDir": ".session",
    "cloudMetricsFile": "cloud-metrics.json",
    "hybridMetricsFile": "hybrid-metrics.json",
    "dashboardEndpoint": "/api/cloud/metrics",
    "autoReportToDashboard": true
  },

  "alerts": {
    "highCostThreshold": 0.01,
    "highLatencyThresholdMs": 5000,
    "circuitBreakerOpenAlert": true,
    "providerFailureRateThreshold": 0.1
  },

  "secrets": {
    "source": "env",
    "awsAccessKeyId": "AWS_ACCESS_KEY_ID",
    "awsSecretAccessKey": "AWS_SECRET_ACCESS_KEY",
    "awsRegion": "AWS_REGION",
    "azureFunctionUrl": "AZURE_FUNCTION_URL",
    "azureFunctionKey": "AZURE_FUNCTION_KEY",
    "azureAccessToken": "AZURE_ACCESS_TOKEN"
  }
}
