{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/z-ai/glm-5",
  "small_model": "openrouter/qwen/qwen-3.6-plus",
  "provider": {
    "ollama": {
      "id": "ollama",
      "name": "Ollama Local",
      "api": "openai",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "qwen2.5-coder:3b": {},
        "qwen2.5-coder:7b": {},
        "qwen2.5-coder:14b": {},
        "qwen3-coder:latest": {}
      }
    }
  },
  "agent": {
    "orchestrator": {
      "description": "Main orchestrator agent — coordinates all subagents autonomously",
      "mode": "primary",
      "model": "openrouter/qwen/qwen-3.6-plus",
      "options": {
        "minTokens": 2000,
        "maxTokens": 4500,
        "temperature": 0.3
      },
      "permission": {
        "websearch": "deny",
        "webfetch": "deny",
        "task": {
          "*": "allow"
        }
      },
      "steps": 12
    },
    "sdd-explore": {
      "description": "BA exploration agent — requirements gathering and analysis",
      "mode": "subagent",
      "hidden": true,
      "model": "openrouter/moonshot/kimi-k2.6",
      "options": {
        "minTokens": 2000,
        "maxTokens": 5000,
        "temperature": 0.7
      },
      "permission": {
        "websearch": "deny",
        "webfetch": "deny"
      },
      "routing": "@{preProcess=npx tsx src/pre-process-input.ts; mappings=config/auto-delegation.json#keywordMappings; agentProfiles=config/auto-delegation.json#agentProfiles; fallbackStrategy=clarify-ba}",
      "steps": 6
    },
    "sdd-design": {
      "description": "SAD architecture design agent — system design and API contracts",
      "mode": "subagent",
      "hidden": true,
      "model": "openrouter/moonshot/kimi-k2.6",
      "options": {
        "minTokens": 2000,
        "maxTokens": 5000,
        "temperature": 0.3
      },
      "permission": {
        "websearch": "deny",
        "webfetch": "deny"
      },
      "routing": "@{preProcess=npx tsx src/pre-process-input.ts; mappings=config/auto-delegation.json#keywordMappings; agentProfiles=config/auto-delegation.json#agentProfiles; fallbackStrategy=clarify-ba}",
      "steps": 6
    },
    "sdd-apply": {
      "description": "DEV implementation agent — code generation and feature building",
      "mode": "subagent",
      "hidden": true,
      "model": "openrouter/z-ai/glm-5",
      "options": {
        "minTokens": 2000,
        "maxTokens": 6000,
        "temperature": 0.15
      },
      "permission": {
        "websearch": "deny",
        "webfetch": "deny"
      },
      "routing": "@{preProcess=npx tsx src/pre-process-input.ts; mappings=config/auto-delegation.json#keywordMappings; agentProfiles=config/auto-delegation.json#agentProfiles; fallbackStrategy=clarify-ba}",
      "steps": 6
    },
    "sdd-verify": {
      "description": "QA verification agent — testing and validation",
      "mode": "subagent",
      "hidden": true,
      "model": "openrouter/z-ai/glm-5",
      "options": {
        "minTokens": 2000,
        "maxTokens": 5000,
        "temperature": 0.1
      },
      "permission": {
        "websearch": "deny",
        "webfetch": "deny"
      },
      "routing": "@{preProcess=npx tsx src/pre-process-input.ts; mappings=config/auto-delegation.json#keywordMappings; agentProfiles=config/auto-delegation.json#agentProfiles; fallbackStrategy=clarify-ba}",
      "steps": 6
    },
    "doc-agent": {
      "description": "Documentation agent — technical docs and guides",
      "mode": "subagent",
      "hidden": true,
      "model": "openrouter/qwen/qwen-3.6-plus",
      "options": {
        "minTokens": 2000,
        "maxTokens": 5000,
        "temperature": 0.4
      },
      "permission": {
        "websearch": "deny",
        "webfetch": "deny"
      },
      "routing": "@{preProcess=npx tsx src/pre-process-input.ts; mappings=config/auto-delegation.json#keywordMappings; agentProfiles=config/auto-delegation.json#agentProfiles; fallbackStrategy=clarify-ba}",
      "steps": 6
    },
    "ops-agent": {
      "description": "Operations agent — deployment, CI/CD, infrastructure",
      "mode": "subagent",
      "hidden": true,
      "model": "openrouter/z-ai/glm-5",
      "options": {
        "minTokens": 2000,
        "maxTokens": 5000,
        "temperature": 0.1
      },
      "permission": {
        "websearch": "deny",
        "webfetch": "deny"
      },
      "routing": "@{preProcess=npx tsx src/pre-process-input.ts; mappings=config/auto-delegation.json#keywordMappings; agentProfiles=config/auto-delegation.json#agentProfiles; fallbackStrategy=clarify-ba}",
      "steps": 6
    },
    "gov-agent": {
      "description": "Governance agent — compliance, security, audit",
      "mode": "subagent",
      "hidden": true,
      "model": "openrouter/moonshot/kimi-k2.6",
      "options": {
        "minTokens": 2000,
        "maxTokens": 5000,
        "temperature": 0.1
      },
      "permission": {
        "websearch": "deny",
        "webfetch": "deny"
      },
      "routing": "@{preProcess=npx tsx src/pre-process-input.ts; mappings=config/auto-delegation.json#keywordMappings; agentProfiles=config/auto-delegation.json#agentProfiles; fallbackStrategy=clarify-ba}",
      "steps": 6
    },
    "session-agent": {
      "description": "Session management agent — state tracking and lifecycle",
      "mode": "subagent",
      "hidden": true,
      "model": "openrouter/qwen/qwen-3.6-plus",
      "options": {
        "minTokens": 1000,
        "maxTokens": 2000,
        "temperature": 0.1
      },
      "permission": {
        "websearch": "deny",
        "webfetch": "deny"
      },
      "routing": "@{preProcess=npx tsx src/pre-process-input.ts; mappings=config/auto-delegation.json#keywordMappings; agentProfiles=config/auto-delegation.json#agentProfiles; fallbackStrategy=clarify-ba}",
      "steps": 6
    },
    "premortem-agent": {
      "description": "Premortem analysis agent — risk identification and stress testing",
      "mode": "subagent",
      "hidden": true,
      "model": "openrouter/z-ai/glm-5",
      "options": {
        "minTokens": 2000,
        "maxTokens": 6000,
        "temperature": 0.15
      },
      "permission": {
        "websearch": "deny",
        "webfetch": "deny"
      },
      "routing": "@{preProcess=npx tsx src/pre-process-input.ts; mappings=config/auto-delegation.json#keywordMappings; agentProfiles=config/auto-delegation.json#agentProfiles; fallbackStrategy=clarify-ba}",
      "steps": 6
    }
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": "codegraph serve --mcp",
      "enabled": true
    },
    "engram": {
      "type": "stdio",
      "command": "engram",
      "args": "mcp --tools=agent",
      "enabled": true
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": "-y chrome-devtools-mcp@latest --isolated",
      "enabled": true
    },
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": "-y @modelcontextprotocol/server-filesystem@latest C:\\Workspace_local",
      "enabled": true
    },
    "memory": {
      "type": "stdio",
      "command": "npx",
      "args": "-y @modelcontextprotocol/server-memory@latest",
      "enabled": true
    }
  },
  "tools": {
    "bash": true,
    "readFile": true,
    "writeFile": true,
    "editFile": true,
    "listFiles": true
  },
  "default_agent": "orchestrator",
  "share": "manual",
  "compaction": {
    "auto": true,
    "prune": true
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      ".engram-data/**",
      "tmp-session-debug/**",
      "logs/**",
      "session/**"
    ]
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "skill": "allow",
    "question": "allow",
    "todowrite": "allow",
    "lsp": "ask",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "ask",
    "doom_loop": "deny",
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "rg *": "allow",
      "Get-ChildItem *": "allow",
      "Test-Path *": "allow"
    },
    "task": {
      "*": "allow"
    }
  },
  "references": {}
}