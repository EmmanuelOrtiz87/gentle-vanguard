{
  "_comment": "TypeScript code coverage thresholds for CI gates",
  "version": "2.0.0",
  "minimumCoverage": 40,
  "thresholds": {
    "lines": 40,
    "functions": 40,
    "branches": 30,
    "statements": 40
  },
  "coverageTargets": [
    {
      "name": "event-sourcing-critical",
      "threshold": 60,
      "tests": ["tests/unit/event-sourcing-hashchain.test.ts"],
      "source": ["src/event-sourcing.ts"]
    },
    {
      "name": "secret-scanner",
      "threshold": 70,
      "tests": ["tests/unit/secret-scanner.test.ts"],
      "source": ["src/secret-scanner.ts"]
    },
    {
      "name": "structural-compression",
      "threshold": 60,
      "tests": ["tests/unit/structural-compression.test.ts"],
      "source": ["src/compression/structural-compression.ts"]
    },
    {
      "name": "security-orchestrator",
      "threshold": 60,
      "tests": ["tests/security/security-orchestrator.test.ts"],
      "source": ["src/security/security-orchestrator.ts"]
    }
  ],
  "include": ["src/**/*.ts", "scripts/**/*.ts"],
  "exclude": [
    "src/**/*.d.ts",
    "src/**/*.test.ts",
    "scripts/**/*.test.ts",
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "apps/web-dashboard/dist/**"
  ],
  "outputDir": "coverage",
  "reportFormats": ["text", "lcov", "html"],
  "_notes": {
    "thresholds": "Starting low (30%) and raising by 5% each month",
    "target_2026_Q3": {
      "lines": 50,
      "functions": 50,
      "branches": 45
    },
    "target_2026_Q4": {
      "lines": 70,
      "functions": 70,
      "branches": 65
    }
  }
}
