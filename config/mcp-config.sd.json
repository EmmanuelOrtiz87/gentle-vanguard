{
  "version": "1.0.0",
  "platform": "sd",
  "mcp": {
    "enabled": true,
    "autoStart": true,
    "servers": [
      {
        "name": "filesystem",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-filesystem", "."],
        "enabled": true
      },
      {
        "name": "memory",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-memory"],
        "enabled": true
      }
    ],
    "tools": {
      "autoRegister": true,
      "timeout": 30000
    }
  }
}
