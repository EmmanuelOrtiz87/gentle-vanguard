{
  "_comment": "TypeScript code coverage thresholds for CI gates",
  "version": "2.0.0",
  "minimumCoverage": 30,
  "thresholds": {
    "lines": 30,
    "functions": 30,
    "branches": 25,
    "statements": 30
  },
  "coverageTargets": [
    {
      "name": "session-autostart-critical",
      "threshold": 60,
      "tests": ["tests/integration/session-autostart.test.ts"],
      "source": ["src/session-autostart.ts"]
    },
    {
      "name": "engram-orchestrator-critical",
      "threshold": 60,
      "tests": ["tests/integration/engram-orchestrator.test.ts"],
      "source": ["src/engram-orchestrator.ts"]
    },
    {
      "name": "routing-critical-flows",
      "threshold": 70,
      "tests": ["tests/integration/routing-critical-flows.test.ts"],
      "source": ["src/agent-router.ts"]
    },
    {
      "name": "security-orchestrator",
      "threshold": 60,
      "tests": ["tests/security/security-orchestrator.test.ts"],
      "source": ["src/security-orchestrator.ts"]
    }
  ],
  "include": ["src/**/*.ts", "scripts/**/*.ts"],
  "exclude": [
    "src/**/*.d.ts",
    "src/**/*.test.ts",
    "scripts/**/*.test.ts",
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "apps/web-dashboard/dist/**"
  ],
  "outputDir": "coverage",
  "reportFormats": ["text", "lcov", "html"],
  "_notes": {
    "thresholds": "Starting low (30%) and raising by 5% each month",
    "target_2026_Q3": {
      "lines": 50,
      "functions": 50,
      "branches": 45
    },
    "target_2026_Q4": {
      "lines": 70,
      "functions": 70,
      "branches": 65
    }
  }
}
