  "breakGlass": {
    "enabled": true,
    "description": "Emergency override for token optimization. Use only when constraints prevent task completion.",
    "overrideProfiles": ["lleno", "lite"],
    "overrideChatLevels": ["chat-balanced", "chat-detailed"],
    "maxOverridesPerSession": 3,
    "maxOverridesPerHour": 2,
    "cooldownTurns": 5,
    "requiresReason": true,
    "auditLog": ".logs/output-compression-breakglass.jsonl",
    "detectionTriggers": [
      "user reports incomplete task",
      "same task spans 3+ turns",
      "truncated output detected",
      "loop detected"
    ]
  },

  "autoMode": {
    "enabled": true,
    "description": "Automatically select profile based on token budget",
    "thresholds": {
      "critical": { "budgetPct": 95, "profile": "ultra", "chatLevel": "chat-compact" },
      "high": { "budgetPct": 85, "profile": "ultra", "chatLevel": "chat-compact" },
      "medium": { "budgetPct": 70, "profile": "simple", "chatLevel": "chat-compact" },
      "normal": { "budgetPct": 50, "profile": "lleno", "chatLevel": "chat-balanced" },
      "low": { "budgetPct": 0, "profile": "lite", "chatLevel": "chat-balanced" }
    }
  },

  "metrics": {
    "enabled": true,
    "trackCompressionRatio": true,
    "trackTokenSavings": true,
    "trackLineReduction": true,
    "storagePath": ".runtime/output-compression-metrics.json",
    "reportInterval": 100
  },

  "integration": {
    "orchestratorConfig": "config/orchestrator.json",
    "tokenBudgetGuard": "config/token-budget-guard.json",
    "responseCache": "src/resilience/response-cache.ts",
    "promptCompression": "src/compression/prompt-compression.ts",
    "preProcessInput": "src/tools/pre-process-input.ts"
  }
}
