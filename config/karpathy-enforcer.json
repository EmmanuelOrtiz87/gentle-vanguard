{
  "karpathy": {
    "version": "1.0.0",
    "guidelines": {
      "thinkFirst": {
        "enabled": true,
        "description": "Understand before coding"
      },
      "simplicity": {
        "enabled": true,
        "description": "Simple > ingenious"
      },
      "surgical": {
        "enabled": true,
        "description": "Minimal focused changes"
      },
      "goalDriven": {
        "enabled": true,
        "description": "Include tests with code changes"
      }
    },
    "enforcement": {
      "mode": "warn",
      "baselineFile": ".runtime/quality/karpathy-baseline.json"
    }
  }
}
