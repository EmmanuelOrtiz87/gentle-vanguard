{
  "version": "1.0.0",
  "description": "Self-reflection loop configuration — controls meta-cognitive analysis and auto-adaptation",
  "minSessionsForTrend": 3,
  "maxPatterns": 15,
  "maxInsights": 10,
  "maxSuggestions": 8,
  "autoApplyThreshold": 0.8,
  "outputDir": ".session/reflections",
  "monitoring": {
    "enabled": true,
    "checkIntervalSessions": 3,
    "alertOnCritical": true
  },
  "autoApply": {
    "pipelineStepInjection": true,
    "configTweaks": false,
    "maxChangesPerReflection": 3
  },
  "sources": {
    "auditLogs": true,
    "corrections": true,
    "metrics": true,
    "tokenUsage": true,
    "gitHistory": true,
    "checkpoints": true
  }
}
